# Imported from form-extensions's upstream phpstan-baseline.neon at the tag in UPSTREAM.md,
# with the paths rewritten for the adminata layout.
parameters:
    ignoreErrors:
        - # `InlineConstraint::__sleep()` returns [] for closure-based constraints, so
          # unserialize() leaves the promoted properties uninitialised even though they declare a
          # default. PHPStan models them as always set, so it reports the `?? null` guards as
          # unnecessary; removing them makes `testClosureSerialization` fatal.
            message: '#^Coalesce operator \?\? is unnecessary because the left side is always set and the right side is null\.$#'
            path: ../packages/form-extensions/src/Validator/Constraints/InlineConstraint.php
