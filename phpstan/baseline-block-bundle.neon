# Imported from block-bundle's upstream phpstan-baseline.neon at the tag in UPSTREAM.md,
# with the paths rewritten for the adminata layout.
parameters:
    ignoreErrors:
        - # https://github.com/phpstan/phpstan-strict-rules/issues/130
            message: '#^Call to static method PHPUnit\\Framework\\Assert::.* will always evaluate to true\.$#'
            path: ../packages/block-bundle/tests
