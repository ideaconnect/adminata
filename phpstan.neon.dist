# PHPStan for the whole repository: the three forked package directories and adminata's own PHP.
# Each package's upstream baseline is imported under phpstan/, with its paths rewritten.
# block-bundle, exporter, form-extensions and twig-extensions have no baseline of their own: their
# trees now live in packages/admin-bundle, so what their upstream baselines contributed is in
# phpstan/baseline-admin-bundle.neon. doctrine-extensions ships no upstream baseline at all.

includes:
    - phpstan/baseline-admin-bundle.neon
    - phpstan/baseline-doctrine-orm-admin-bundle.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    symfony:
        consoleApplicationLoader: ./phpstan-console-application.php
    paths:
        - packages/admin-bundle/src
        - packages/admin-bundle/tests
        - packages/doctrine-extensions/src
        - packages/doctrine-extensions/tests
        - packages/doctrine-orm-admin-bundle/src
        - packages/doctrine-orm-admin-bundle/tests
        - tests
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    excludePaths:
        analyseAndScan:
            - packages/admin-bundle/src/Resources/skeleton/**
            # Symfony writes this IDE helper into a test application's config directory on every
            # debug-mode build. It is generated and gitignored, it names config classes for bundles
            # the kernel that produced it happened to register, and analysing it fails as soon as
            # one of those bundles is not installed. `.php-cs-fixer.dist.php` and
            # `.php-cs-fixer.adminata.php` skip it for the same reason.
            - tests/App/config/reference.php
            - packages/*/tests/App/config/reference.php
    treatPhpDocTypesAsCertain: false
    checkInternalClassCaseSensitivity: true
    checkMissingVarTagTypehint: true
    checkMissingTypehints: true
    checkUninitializedProperties: true
    featureToggles:
        skipCheckGenericClasses:
            - Symfony\Component\Form\AbstractType
            - Symfony\Component\Form\FormBuilderInterface
            # `@template T of FormError|FormErrorIterator` names the class in its own bound, and
            # PHPStan resolves that recursion inconsistently: the type it infers for
            # `FormInterface::getErrors()` and the type it renders for a parameter declared
            # `FormErrorIterator<FormError>` are the same set written two ways, and it rejects one
            # against the other — always in a single process, intermittently across workers, and
            # then from the result cache for ever after. Erasing the class's generics is what makes
            # the analysis agree with itself; `FormErrorIteratorToConstraintViolationList` narrows
            # the element type with an `instanceof` instead. Not in the upstream list because
            # upstream's pinned PHPStan did not reach that resolution.
            - Symfony\Component\Form\FormErrorIterator
            - Symfony\Component\Form\FormInterface
            - Symfony\Component\Form\FormTypeExtensionInterface
            - Symfony\Component\Form\FormTypeInterface
