<?xml version="1.0" encoding="UTF-8"?>

<!--
    One configuration for the whole repository: the bundle's own suite under tests/ — the six
    forked trees' tests, all of them, because admin-bundle carries the block, doctrine, exporter,
    form and twig stacks — plus adminata's own suites under tests-adminata/. The per-package
    phpunit.xml.dist files were deleted at import; `KERNEL_CLASS` is set per test class by
    Adminata\Tests\PHPUnit\KernelClassExtension, because the two trees ship different kernels.
-->

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         displayDetailsOnAllIssues="true"
         cacheDirectory=".phpunit.cache"
         bootstrap="tests-adminata/bootstrap.php"
>
    <testsuites>
        <testsuite name="admin">
            <directory>tests</directory>
        </testsuite>
        <testsuite name="adminata-unit">
            <directory>tests-adminata/Unit</directory>
        </testsuite>
        <testsuite name="adminata-functional">
            <directory>tests-adminata/Functional</directory>
        </testsuite>
        <testsuite name="adminata-contract">
            <directory>tests-adminata/Contract</directory>
        </testsuite>
    </testsuites>

    <!-- The `network` group reaches Packagist. Run it on request: vendor/bin/phpunit 
         with the network group selected on the command line. -->
    <groups>
        <exclude>
            <group>network</group>
            <!-- Browser scenarios that click through the inherited Bootstrap interface. Its CSS
                 and JavaScript are gone since P1-02; M3 and M4 rewrite the templates and drop
                 the group again. -->
            <group>legacy-ui</group>
        </exclude>
    </groups>

    <source ignoreSuppressionOfDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

    <extensions>
        <bootstrap class="Adminata\Tests\PHPUnit\KernelClassExtension" />
        <bootstrap class="Adminata\Tests\PHPUnit\DemoDatabaseExtension" />
        <bootstrap class="Symfony\Component\Panther\ServerExtension" />
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>

    <php>
        <ini name="precision" value="8" />
        <!-- adminata supports MySQL, MariaDB and Percona; `docker compose up -d` starts a
             matching MySQL. Override these to run the suites against your own server. -->
        <server name="ADMINATA_TEST_DATABASE_URL" value="mysql://root:adminata@127.0.0.1:7010/adminata_test?serverVersion=8.4.0&amp;charset=utf8mb4" />
        <server name="ADMINATA_DEMO_DATABASE_URL" value="mysql://root:adminata@127.0.0.1:7010/adminata_demo?serverVersion=8.4.0&amp;charset=utf8mb4" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="APP_DEBUG" value="false" />
    </php>
</phpunit>
