# Inherited from sonata-project/dev-kit, with adminata's ignore list.

ignore: |
    vendor/
    node_modules/
    var/
    # Byte-for-byte captures of YamlReferenceDumper's output, which pads values into columns.
    # Reformatting them would make the contract test compare against something the dumper cannot
    # produce.
    tests/Contract/config-reference/

extends: default

rules:
    # Prettier formats adminata's own YAML and writes `{ a: b }`; yamllint's default forbids the
    # spaces. Allowing either keeps one formatter in charge without the linter fighting it.
    braces:
        max-spaces-inside: 1
    comments: disable
    comments-indentation: disable
    document-start: disable
    empty-lines:
        max: 1
        max-start: 0
        max-end: 0
    line-length: disable
    truthy:
        allowed-values: ['true', 'false']
        check-keys: false
