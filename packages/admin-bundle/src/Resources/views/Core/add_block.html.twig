{#
    The header's "add" panel: one column per `dropdown_number_groups_per_colums` groups, each
    listing the admins the visitor may create (PLAN/03 §A row 5).

    Upstream built the columns by opening and closing `<ul>`s inside one loop, which is why it also
    reversed the groups; here the groups are batched and the columns are a grid, so they read in
    dashboard order.

    The ARIA menu pattern is complete rather than half-applied: `role="menu"` on the panel,
    `role="none"` on the list and its items, `role="menuitem"` on the links, and the arrow-key
    handling `sonata-dropdown` provides. Upstream emitted `role="menuitem"` inside a plain `<ul>`,
    which is what axe reports as `aria-required-parent`.
#}

{% set items_per_column = sonata_config.getOption('dropdown_number_groups_per_colums') %}
{% set groups = get_sonata_dashboard_groups_with_creatable_admins() %}
{% set groups = groups|filter(group =>
    group.roles is empty
    or is_granted(sonata_config.getOption('role_admin'))
    or group.roles|filter(role => is_granted(role))|length > 0
) %}
{% set columns = groups|batch(items_per_column) %}

{% if groups|length > 0 %}
    <div class="adm-dropdown__menu dropdown-add" role="menu" hidden {{ stimulus_target('sonata-dropdown', 'menu') }}>
        <div class="grid gap-4" style="grid-template-columns: repeat({{ columns|length }}, minmax(10rem, 1fr))">
            {% for column in columns %}
                <ul role="none">
                    {% for group in column %}
                        <li role="none">
                            <p class="flex items-center gap-2 px-3 py-2 text-theme-xs font-medium text-gray-500 uppercase dark:text-gray-400">
                                {{ group.icon|parse_icon }}
                                {# NEXT_MAJOR: Remove the default null #}
                                {% if group.translation_domain|default(null) is same as(false) %}
                                    {{ group.label }}
                                {% else %}
                                    {# NEXT_MAJOR: Remove the fallback on group.label_catalogue #}
                                    {{ group.label|trans({}, group.translation_domain|default(group.label_catalogue)) }}
                                {% endif %}
                            </p>

                            <ul role="none">
                                {% for admin in group.items %}
                                    {% if admin.hasRoute('create') and admin.hasAccess('create') %}
                                        {% if admin.subClasses is empty %}
                                            <li role="none">
                                                <a class="adm-dropdown__item" role="menuitem" href="{{ admin.generateUrl('create') }}">
                                                    {% if admin.label is not empty %}
                                                        {{ admin.label|trans({}, admin.translationdomain) }}
                                                    {% endif %}
                                                </a>
                                            </li>
                                        {% else %}
                                            {% for subclass in admin.subclasses|keys %}
                                                <li role="none">
                                                    <a class="adm-dropdown__item" role="menuitem" href="{{ admin.generateUrl('create', {'subclass': subclass}) }}">
                                                        {{ subclass|trans({}, admin.translationdomain) }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </div>
    </div>
{% endif %}
