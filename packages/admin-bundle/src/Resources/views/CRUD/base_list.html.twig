{#
    The list (PLAN/03 §B row 1).

    A card holding the table, a footer *outside* the horizontally scrolling wrapper — a dropdown
    inside an `overflow-x: auto` box is clipped by it, which is why upstream's export menu needed
    a hundred pixels of bottom margin — and the filters in a card of their own.

    Every id, class and field name the contract names is where it was (PLAN/02 §8): `sonata-ba-list`,
    `sonata-ba-list-field-header*`, `#list_batch_checkbox`, `#{uniqid}_all_elements`,
    `sonata-filter-form`, `sonata-toggle-filter`, `advanced-filter`, `#filter-list-{uniqid}`,
    `#filter-container-{uniqid}`, `#filter-{uniqid}-{name}`, and the POST fields `action`, `idx[]`,
    `all_elements` and `_sonata_csrf_token`.
#}

{% extends base_template %}

{%- block actions -%}
    {% include '@SonataAdmin/CRUD/action_buttons.html.twig' %}
{%- endblock -%}

{%- block tab_menu -%}
    {{ knp_menu_render(admin.sidemenu(action), {
        'currentClass': 'active',
        'template': get_global_template('tab_menu_template')
    }, 'twig') }}
{%- endblock -%}

{% block title %}
    {{ admin.isChild and admin.parent.subject ? 'title_edit'|trans({'%name%': admin.parent.toString(admin.parent.subject)|u.truncate(15, '...') }, 'SonataAdminBundle') : '' }}
{% endblock %}

{% block navbar_title %}
    {{ admin.isChild and admin.parent.subject ? 'title_edit'|trans({'%name%': admin.parent.toString(admin.parent.subject)|u.truncate(100, '...') }, 'SonataAdminBundle') : '' }}
{% endblock %}

{# Define the variable out of the block to prevent error if someone is overriding the list_table and not the list_footer #}
{% set datagrid_has_results = admin.datagrid.results|length > 0 %}

{% block list_table %}
    <div class="col-span-12">
        {% set batchactions = admin.batchactions %}
        {% set has_batch = admin.hasRoute('batch') and batchactions|length > 0 %}

        {% if has_batch %}
            <form action="{{ admin.generateUrl('batch', {'filter': admin.filterParameters}) }}" method="POST"
                  {{ stimulus_controller('sonata-batch') }}
            >
            <input type="hidden" name="_sonata_csrf_token" value="{{ csrf_token }}">
        {% endif %}

        <div class="adm-card">
            <div class="adm-card-body {% if datagrid_has_results %}p-0{% endif %}">
                {{ sonata_block_render_event('sonata.admin.list.table.top', { 'admin': admin }) }}

                {% block list_header %}{% endblock %}

                {% if datagrid_has_results %}
                    {# The table scrolls inside its own box; the page does not (PLAN/08 §8). #}
                    <div class="adm-table-wrap">
                    {% block table %}
                        <table class="adm-table sonata-ba-list">
                        {% block table_header %}
                            <thead>
                                <tr class="sonata-ba-list-field-header">
                                    {% for field_description in admin.list.getElements() %}
                                        {% if admin.hasRoute('batch') and field_description.name == constant('Sonata\\AdminBundle\\Datagrid\\ListMapper::NAME_BATCH') and batchactions|length > 0 %}
                                            <th class="sonata-ba-list-field-header sonata-ba-list-field-header-batch">
                                              <input type="checkbox" class="adm-checkbox" id="list_batch_checkbox"
                                                     aria-label="{{ 'all_elements'|trans({}, 'SonataAdminBundle') }}"
                                                     {{ stimulus_target('sonata-batch', 'all') }}
                                                     {{ stimulus_action('sonata-batch', 'toggleAll', 'change') }}>
                                            </th>
                                        {% elseif field_description.name == constant('Sonata\\AdminBundle\\Datagrid\\ListMapper::NAME_SELECT') %}
                                            <th class="sonata-ba-list-field-header sonata-ba-list-field-header-select"></th>
                                        {% elseif field_description.name == constant('Sonata\\AdminBundle\\Datagrid\\ListMapper::NAME_ACTIONS') and app.request.isXmlHttpRequest %}
                                            {# NEXT_MAJOR: Remove this case in version 5 and recommend using the option `ajax_hidden` instead. #}
                                            {# Action buttons disabled in ajax view! #}
                                        {% elseif field_description.getOption('ajax_hidden') == true and app.request.isXmlHttpRequest %}
                                            {# Disable fields with 'ajax_hidden' option set to true #}
                                        {% else %}
                                            {% set sortable = false %}
                                            {% if field_description.option('sortable', false) %}
                                                {% set sortable             = true %}
                                                {% set sort_parameters      = admin.datagrid.sortparameters(field_description) %}
                                                {% set current              = admin.datagrid.values[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_BY')] is defined
                                                    and (admin.datagrid.values[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_BY')] == field_description
                                                        or admin.datagrid.values[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_BY')].name == sort_parameters.filter[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_BY')]) %}
                                                {% set sort_active_class    = current ? 'sonata-ba-list-field-order-active' : '' %}
                                                {% set sort_by              = current ? admin.datagrid.values[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_ORDER')] : field_description.option(constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_ORDER'), sort_parameters.filter[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::SORT_ORDER')]) %}
                                            {% endif %}

                                            <th class="sonata-ba-list-field-header-{{ field_description.type }}{% if sortable %} sonata-ba-list-field-header-order-{{ sort_by|lower }} {{ sort_active_class }}{% endif %}{% if field_description.option('header_class') %} {{ field_description.option('header_class') }}{% endif %}"{% if field_description.option('header_style') %} style="{{ field_description.option('header_style') }}"{% endif %}{% if sortable and current %} aria-sort="{{ 'asc' == sort_by|lower ? 'descending' : 'ascending' }}"{% endif %}>
                                                {% if sortable %}
                                                    <a class="inline-flex items-center gap-1" href="{{ admin.generateUrl(action|default('list'), sort_parameters|merge({_list_mode: admin.getListMode()})) }}">
                                                {% endif %}
                                                {% if field_description.getOption('label_icon') %}
                                                    <span class="sonata-ba-list-field-header-label-icon">
                                                        {{ field_description.getOption('label_icon')|parse_icon }}
                                                    </span>
                                                {% endif %}
                                                {% if field_description.label is not same as(false) %}
                                                    {% if field_description.translationDomain is same as(false) %}
                                                        {{ field_description.label }}
                                                    {% else %}
                                                        {{ field_description.label|trans({}, field_description.translationDomain) }}
                                                    {% endif %}
                                                {% endif %}
                                                {% if sortable %}
                                                    <i class="fas fa-sort{% if current %}-{{ 'asc' == sort_by|lower ? 'up' : 'down' }}{% endif %} text-theme-xs" aria-hidden="true"></i>
                                                    </a>
                                                {% endif %}
                                            </th>
                                        {% endif %}
                                    {% endfor %}
                                </tr>
                            </thead>
                        {% endblock %}

                        {% block table_body %}
                            <tbody>
                                {% include get_admin_template('outer_list_rows_' ~ admin.getListMode(), admin.code) %}
                            </tbody>
                        {% endblock %}

                        {% block table_footer %}
                        {% endblock %}
                    </table>
                    {% endblock %}
                    </div>
                {% else %}
                    {% block no_result_content %}
                        <div class="adm-list-empty">
                            <i class="fas fa-inbox text-2xl" aria-hidden="true"></i>
                            <p>{{ 'no_result'|trans({}, 'SonataAdminBundle') }}</p>

                            {%- if admin.datagrid.pager.countResults() > 0 -%}
                                <a class="adm-btn adm-btn-secondary adm-btn-sm" href="{{ admin.generateUrl(action|default('list'), admin.datagrid.getPaginationParameters(1)) }}">
                                    {{- 'go_to_the_first_page'|trans({}, 'SonataAdminBundle') -}}
                                </a>
                            {%- elseif not app.request.xmlHttpRequest -%}
                                <ul class="list-none">
                                    {%- include get_admin_template('button_create', admin.code) -%}
                                </ul>
                            {%- endif -%}
                        </div>
                    {% endblock %}
                {% endif %}

                {{ sonata_block_render_event('sonata.admin.list.table.bottom', { 'admin': admin }) }}
            </div>

            {% block list_footer %}
                {% if datagrid_has_results %}
                    <div class="adm-list-footer">
                        {% if not app.request.isXmlHttpRequest %}
                            <div class="flex flex-wrap items-center gap-3">
                                {% if has_batch %}
                                    {% block batch %}
                                        {#
                                            Upstream put twelve lines of jQuery here. The block stays
                                            so an application overriding it keeps compiling; it is
                                            empty, and `sonata-batch` does the work.
                                        #}
                                        {% block batch_javascript %}{% endblock %}

                                        {% block batch_actions %}
                                            {#- No `for`: the label wraps the input, which is the association. -#}
                                            <label class="adm-checkbox-label">
                                                <input type="checkbox" class="adm-checkbox" name="all_elements" id="{{ admin.uniqid }}_all_elements">
                                                {{ 'all_elements'|trans({}, 'SonataAdminBundle') }}
                                                ({{ admin.datagrid.pager.countResults() }})
                                            </label>

                                            <label class="sr-only" for="{{ admin.uniqid }}_batch_action">{{ 'btn_batch'|trans({}, 'SonataAdminBundle') }}</label>
                                            <select class="adm-select w-auto" name="action" id="{{ admin.uniqid }}_batch_action">
                                                {% for action, options in batchactions %}
                                                    <option value="{{ action }}">
                                                        {% if options.translation_domain is defined and options.translation_domain is same as(false) %}
                                                            {{ options.label }}
                                                        {% else %}
                                                            {{ options.label|trans({}, options.translation_domain ?? admin.translationDomain) }}
                                                        {% endif %}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        {% endblock %}

                                        <button type="submit" class="adm-btn adm-btn-primary adm-btn-sm">
                                            {{ 'btn_batch'|trans({}, 'SonataAdminBundle') }}
                                        </button>
                                    {% endblock %}
                                {% endif %}

                                <div class="ms-auto flex flex-wrap items-center gap-3">
                                    {% if admin.hasRoute('export') and admin.hasAccess('export') and export_formats|length %}
                                        <div class="adm-dropdown"
                                             {{ stimulus_controller('sonata-dropdown') }}
                                             {{ stimulus_action('sonata-dropdown', 'closeAndFocus', 'keydown.esc')|stimulus_action('sonata-dropdown', 'navigate', 'keydown') }}
                                        >
                                            <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm"
                                                    aria-expanded="false"
                                                    aria-haspopup="menu"
                                                    {{ stimulus_target('sonata-dropdown', 'toggle') }}
                                                    {{ stimulus_action('sonata-dropdown', 'toggle', 'click') }}
                                            >
                                                <i class="fas fa-share-from-square" aria-hidden="true"></i>
                                                {{ "label_export_download"|trans({}, "SonataAdminBundle") }}
                                                <i class="fas fa-angle-down" aria-hidden="true"></i>
                                            </button>

                                            <ul class="adm-dropdown__menu" role="menu" hidden {{ stimulus_target('sonata-dropdown', 'menu') }}>
                                                {% for format in export_formats %}
                                                    <li role="none">
                                                        <a class="adm-dropdown__item" role="menuitem" href="{{ admin.generateUrl('export', admin.datagrid.paginationparameters(0) + {'format' : format}) }}">
                                                            <i class="fas fa-circle-down" aria-hidden="true"></i>
                                                            {{ ("export_format_" ~ format)|trans({}, 'SonataAdminBundle') }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}

                                    {% block pager_results %}
                                        {% include get_admin_template('pager_results', admin.code) %}
                                    {% endblock %}
                                </div>
                            </div>
                        {% endif %}

                        {% block pager_links %}
                            {% if admin.datagrid.pager.haveToPaginate() %}
                                {% include get_admin_template('pager_links', admin.code) %}
                            {% endif %}
                        {% endblock %}
                    </div>
                {% endif %}
            {% endblock %}
        </div>

        {#
            Additive (PLAN/02 §5): after the card and inside the form, which is where an
            application puts the summaries it used to hang off `list_footer`.
        #}
        {% block list_after_table %}{% endblock %}

        {% if has_batch %}
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block list_filters_actions %}
    {# NEXT_MAJOR: Remove |default(filter.option('show_filter')) #}
    {% set displayableFilters = admin.datagrid.filters|filter(filter => filter.showFilter|default(filter.option('show_filter')) is not same as (false)) %}
    {%- if displayableFilters|length %}
        <div class="adm-dropdown sonata-actions" id="filter-list-{{ admin.uniqid() }}"
             {{ stimulus_controller('sonata-filter-list', {}, { 'active': 'active' }, { 'sonata-filter': '#filter-container-' ~ admin.uniqid() })|stimulus_controller('sonata-dropdown') }}
             {{ stimulus_action('sonata-dropdown', 'closeAndFocus', 'keydown.esc') }}
        >
            <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm sonata-ba-action"
                    aria-expanded="false"
                    {{ stimulus_target('sonata-dropdown', 'toggle') }}
                    {{ stimulus_action('sonata-dropdown', 'toggle', 'click') }}
            >
                <i class="fas fa-filter" aria-hidden="true"></i>
                {{ 'link_filters'|trans({}, 'SonataAdminBundle') }}
                <span class="adm-badge adm-badge-brand" {{ stimulus_target('sonata-filter-list', 'counter') }}></span>
                <i class="fas fa-angle-down" aria-hidden="true"></i>
            </button>

            <ul class="adm-dropdown__menu max-h-[75vh] overflow-y-auto" hidden {{ stimulus_target('sonata-dropdown', 'menu') }}>
                {% for filter in displayableFilters %}
                    {# NEXT_MAJOR: Remove |default(filter.option('show_filter')) #}
                    {% set filterDisplayed = filter.isActive() or filter.showFilter|default(filter.option('show_filter')) is same as (true) %}
                    <li>
                        <button type="button"
                                class="adm-dropdown__item sonata-toggle-filter sonata-ba-action{% if filterDisplayed %} active{% endif %}"
                                aria-pressed="{{ filterDisplayed ? 'true' : 'false' }}"
                                data-filter="filter-{{ admin.uniqid }}-{{ filter.name }}"
                                {{ stimulus_target('sonata-filter-list', 'field') }}
                                {{ stimulus_action('sonata-filter-list', 'toggle:prevent:stop', 'click') }}
                        >
                            {% if filter.label is not same as(false) %}
                                {% if filter.translationDomain is same as(false) %}
                                    {{ filter.label }}
                                {% elseif filter.labelTranslationParameters is defined %}
                                    {{ filter.label|trans(filter.labelTranslationParameters, filter.translationDomain ?? admin.translationDomain) }}
                                {% else %} {# NEXT_MAJOR: remove the else part and change elseif to else #}
                                    {{ filter.label|trans(filter.option('label_translation_parameters', {}), filter.translationDomain ?? admin.translationDomain) }}
                                {% endif %}
                            {% endif %}
                        </button>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif -%}
{% endblock %}

{% block list_filters %}
    {% if admin.datagrid.filters %}
        {% form_theme form get_admin_template('filter', admin.code) %}

        <div class="col-span-12 sonata-filters-box"
             id="filter-container-{{ admin.uniqid() }}" {{ stimulus_controller('sonata-filter', { 'defaultValues': admin.defaultFilterParameters|json_encode }, {}, { 'sonata-filter-list': '#filter-list-' ~ admin.uniqid() }) }} {% if not admin.datagrid.hasDisplayableFilters %}hidden{% endif %}>
            <div class="adm-card">
                <div class="adm-card-body">
                    <form
                        class="sonata-filter-form {{ admin.isChild and 1 == admin.datagrid.filters|length ? 'hidden' : '' }}"
                        action="{{ admin.generateUrl(action|default('list')) }}"
                        method="GET"
                        {#- Named rather than `role="form"`: the role on a `<form>` is redundant,
                            and a landmark with no name is noise a screen reader has to step past. -#}
                        aria-label="{{ 'link_filters'|trans({}, 'SonataAdminBundle') }}"
                        {{ stimulus_target('sonata-filter', 'form') }}
                        {{ stimulus_action('sonata-filter', 'prepareSubmit', 'submit') }}>
                        {{ form_errors(form) }}

                        <div class="flex flex-col gap-3">
                            {% set withAdvancedFilter = false %}
                            {% for filter in admin.datagrid.filters %}
                                {# NEXT_MAJOR: Remove |default(filter.option('show_filter')) #}
                                {% set filterDisplayed = filter.isActive() or filter.showFilter|default(filter.option('show_filter')) is same as (true) %}
                                {% set filterCanBeDisplayed = filter.option('show_filter') is not same as(false) %}
                                {#- A range filter's value is two inputs, so its label cannot be a
                                    `<label for>`: the id belongs to their container. It becomes the
                                    name of a group instead, and each input carries its own
                                    `aria-label` from the filter theme. -#}
                                {% set valueField = form[filter.formName].children['value'] %}
                                {% set valueIsCompound = valueField.children|length > 0 %}
                                {% set filterLabelId = 'filter-' ~ admin.uniqid ~ '-' ~ filter.name ~ '-label' %}
                                <div class="grid grid-cols-12 items-center gap-3 {% block sonata_list_filter_group_class %}{% endblock %}" id="filter-{{ admin.uniqid }}-{{ filter.name }}" {{ stimulus_target('sonata-filter', 'group') }}{% if valueIsCompound and filter.label is not same as(false) %} role="group" aria-labelledby="{{ filterLabelId }}"{% endif %} {% if not filterDisplayed %}hidden{% endif %}>
                                    {% if filter.label is not same as(false) %}
                                        {% if valueIsCompound %}
                                            <span id="{{ filterLabelId }}" class="adm-label col-span-12 mb-0 md:col-span-3">
                                        {% else %}
                                            <label for="{{ valueField.vars.id }}" class="adm-label col-span-12 mb-0 md:col-span-3">
                                        {% endif %}
                                            {% if filter.translationDomain is same as(false) %}
                                                {{ filter.label }}
                                            {% else %}
                                                {{ filter.label|trans(filter.option('label_translation_parameters', {}), filter.translationDomain ?? admin.translationDomain) }}
                                            {% endif %}
                                        {{ valueIsCompound ? '</span>'|raw : '</label>'|raw }}
                                    {% endif %}
                                    {% set attr = form[filter.formName].children['type'].vars.attr|default({}) %}
                                    <div class="advanced-filter col-span-12 md:col-span-3" {{ stimulus_target('sonata-filter', 'advanced') }} {% if not field_value(form[filter.formName].children['type']) %}hidden{% endif %}>
                                        {{ form_widget(form[filter.formName].children['type'], {'attr':  attr}) }}
                                    </div>

                                    <div class="col-span-11 md:col-span-5">
                                        {{ form_widget(form[filter.formName].children['value']) }}
                                    </div>

                                    {% if filterCanBeDisplayed %}
                                        <div class="col-span-1">
                                            <button type="button" class="adm-btn-icon sonata-ba-action"
                                                    aria-label="{{ 'link_reset_filter'|trans({}, 'SonataAdminBundle') }}"
                                                    {{ stimulus_action('sonata-filter', 'hideFilter', 'click', { 'id': 'filter-' ~ admin.uniqid ~ '-' ~ filter.name }) }}
                                            >
                                                <i class="fas fa-circle-minus" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    {% endif %}
                                </div>

                                {# NEXT_MAJOR: Remove |default(filter.option('advanced_filter')) #}
                                {% if filter.withAdvancedFilter|default(filter.option('advanced_filter')) %}
                                    {% set withAdvancedFilter = true %}
                                {% endif %}
                            {% endfor %}
                        </div>

                        <input type="hidden" name="filter[{{ constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::PAGE') }}]" id="filter__page" value="1">

                        {% set foo = form[constant('Sonata\\AdminBundle\\Datagrid\\DatagridInterface::PAGE')].setRendered() %}
                        {{ form_rest(form) }}

                        <div class="mt-4 flex flex-wrap items-center gap-3">
                            <button type="submit" class="adm-btn adm-btn-primary" {{ stimulus_target('sonata-filter', 'submitter') }}>
                                <i class="fas fa-filter" aria-hidden="true"></i> {{ 'btn_filter'|trans({}, 'SonataAdminBundle') }}
                            </button>

                            <a class="adm-btn adm-btn-secondary" href="{{ admin.generateUrl(action|default('list'), {filters: 'reset'}) }}">
                                {{ 'link_reset_filter'|trans({}, 'SonataAdminBundle') }}
                            </a>

                            {% if withAdvancedFilter %}
                                <button type="button" class="adm-btn adm-btn-ghost" {{ stimulus_action('sonata-filter', 'toggleAdvanced', 'click') }}>
                                    <i class="fas fa-gears" aria-hidden="true"></i>
                                    {{ 'btn_advanced_filters'|trans({}, 'SonataAdminBundle') }}
                                </button>
                            {% endif %}
                        </div>

                        {% for paramKey, paramValue in admin.persistentParameters %}
                            <input type="hidden" name="{{ paramKey }}" value="{{ paramValue }}">
                        {% endfor %}
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
