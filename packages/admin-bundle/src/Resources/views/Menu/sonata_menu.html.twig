{#
    The sidebar menu (PLAN/03 §A row 4).

    Upstream handed the tree to AdminLTE's `data-widget="tree"`, which needed jQuery and turned
    every group header into `<a href="#">`. Here a group is a `<button aria-expanded>` and the
    `sonata-menu` controller keeps the open ones in `localStorage`; the server decides which start
    open, from `active` and `keep-open`, so the first paint is right without JavaScript.

    The KnpMenu block names are all still here — an application overriding one of them keeps
    working — and so are `sidebar-menu`, `active` and `keep-open`, which the functional tests and
    an application's CSS select on (PLAN/02 §8).
#}

{% extends 'knp_menu.html.twig' %}

{% block root %}
    {%- set listAttributes = item.childrenAttributes|merge({
        'class': ('sidebar-menu '~item.childrenAttribute('class'))|trim,
    }) -%}
    {%- set request = item.extra('request') ?: app.request -%}
    <nav aria-label="{{ 'sidebar_navigation'|trans({}, 'SonataAdminBundle') }}" {{ stimulus_controller('sonata-menu') }}>
        {{ block('list') -}}
    </nav>
{% endblock %}

{% block item %}
    {#- The role gate, verbatim from upstream: a group is shown when it names no roles, when the
        visitor holds the super-admin role, or when the visitor holds one of the roles it names. -#}
    {%- if item.displayed -%}
        {%- set display = item.extra('roles') is empty or is_granted(sonata_config.getOption('role_super_admin')) or item.extra('roles')|filter(role => is_granted(role))|length > 0 -%}
    {%- endif -%}

    {%- if not item.displayed or not display|default -%}
        {%- set skip = true -%}
    {%- endif -%}

    {%- if skip|default(false) is same as(false) -%}
        {%- set isCurrent = matcher.isCurrent(item) -%}
        {%- set isAncestor = matcher.isAncestor(item, options.matchingDepth) -%}
        {%- set isActive = isCurrent or isAncestor -%}
        {%- set hasChildren = item.hasChildren and options.depth is not same as(0) and item.displayChildren -%}
        {%- set itemClass = item.attribute('class')|default('') -%}
        {#- The application's own subscriber injects inert headers with this class
            (appendix C §2); `section_header` is the extra that says the same thing. -#}
        {%- set isSectionHeader = 'sidebar-section-header' in itemClass|split(' ') or item.extra('section_header', false) -%}

        {#- `active` for both, as upstream forced through `currentClass` and `ancestorClass`:
            it is in the contract (PLAN/02 §8) and KnpMenu's own defaults are `current` and
            `current_ancestor`. -#}
        {%- set classes = itemClass is not empty ? [itemClass] : [] -%}
        {%- if isActive -%}
            {%- set classes = classes|merge(['active']) -%}
        {%- endif -%}

        <li{% if classes is not empty %} class="{{ classes|join(' ')|trim }}"{% endif %}>
            {%- if isSectionHeader -%}
                {#- A `<div>`, not a heading: it labels a run of links inside a `<nav>` that
                    already has a name, and a heading here lands in the document outline above the
                    page's own title. -#}
                <div class="adm-menu-group-title">{{ block('label') }}</div>
            {%- elseif hasChildren -%}
                {{ block('spanElement') }}

                {%- set childrenClasses = item.childrenAttribute('class') is not empty ? [item.childrenAttribute('class')] : [] -%}
                {%- set childrenClasses = childrenClasses|merge(['menu-dropdown', 'menu_level_'~item.level]) -%}
                {#- No `hidden` and no target: the stylesheet hides a panel whose button says
                    `aria-expanded="false"`, so the attribute is the only state there is and the
                    menu is right before any JavaScript runs. -#}
                {%- set listAttributes = item.childrenAttributes|merge({class: childrenClasses|join(' ')}) -%}
                {{ block('list') }}
            {%- else -%}
                {{ block('linkElement') }}
            {%- endif -%}
        </li>
    {%- endif -%}
{% endblock %}

{% block linkElement %}
    {%- set icon = item.extra('icon')|default('')|parse_icon -%}
    {%- set isActive = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) -%}
    {%- set isChild = item.level > 1 -%}
    {%- set base = isChild ? 'menu-dropdown-item' : 'menu-item' -%}
    <a href="{{ item.uri }}"
       class="{{ base }} {{ base }}-{{ isActive ? 'active' : 'inactive' }}"
       {% if isActive %}aria-current="page"{% endif %}
    >
        {{- icon|raw -}}
        <span class="menu-item-text">{{ block('label') }}</span>
    </a>
{% endblock %}

{% block spanElement %}
    {#- A group header. A `<button>`, not the `<a href="#">` upstream used: it does not go
        anywhere, and `aria-expanded` only means something on a control. -#}
    {%- set icon = item.extra('icon')|default('')|parse_icon -%}
    {%- set isActive = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) -%}
    {%- set keepOpen = item.extra('keep_open', false) or 'keep-open' in item.attribute('class')|default('')|split(' ') -%}
    {%- set open = isActive or keepOpen -%}
    <button type="button"
            class="menu-item menu-item-{{ isActive ? 'active' : 'inactive' }}"
            aria-expanded="{{ open ? 'true' : 'false' }}"
            {% if keepOpen %}data-sonata-menu-keep-open="true"{% endif %}
            {{ stimulus_target('sonata-menu', 'toggle') }}
            {{ stimulus_action('sonata-menu', 'toggle', 'click') }}
    >
        {{- icon|raw -}}
        <span class="menu-item-text">{{ block('label') }}</span>
        <i class="fas fa-angle-down menu-item-arrow ms-auto" aria-hidden="true"></i>
    </button>
{% endblock %}

{% block label %}
    {#- We use the method accessor instead of `.label`: `item` implements `ArrayAccess` and could
        have a property called "label". -#}
    {%- set item_label = item.getLabel() -%}
    {%- if options.allow_safe_labels and item.extra('safe_label', false) -%}
        {{ item_label|raw }}
    {%- else -%}
        {# NEXT_MAJOR: Remove the label_catalogue fallback #}
        {%- set translation_domain = item.extra('translation_domain', item.extra('label_catalogue', 'messages')) -%}
        {{ item_label|trans(item.extra('label_translation_parameters', {}), translation_domain) }}
    {%- endif -%}
{% endblock %}
