# Line endings
* text=auto eol=lf
*.woff2 binary
*.png binary
*.gif binary
*.jpg binary
*.ico binary

# Everything below is excluded from the Composer dist archive.
# `assets/` is deliberately NOT excluded: applications import `assets/css/adminata.css`
# and add `@source` globs over `src/` to compile Tailwind themselves.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.nvmrc export-ignore
/.php-cs-fixer.dist.php export-ignore
/.readthedocs.yaml export-ignore
/.symfony.bundle.yaml export-ignore
/.yamllint export-ignore
/.github export-ignore
/PLAN export-ignore
/PROJECT_PLAN.md export-ignore
/bin/build-css-safelist.mjs export-ignore
/bin/check-css-contract.mjs export-ignore
/bin/check-upstream-versions.php export-ignore
/bin/console export-ignore
/bin/tailwind-fixture.mjs export-ignore
/docker-compose.yml export-ignore
/docs export-ignore
/eslint.config.js export-ignore
/infection.json5.dist export-ignore
/package-lock.json export-ignore
/package.json export-ignore
/phpstan export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/playwright.config.ts export-ignore
/prettier.config.js export-ignore
/rector.php export-ignore
/stylelint.config.js export-ignore
/tests export-ignore
/tests-adminata export-ignore
# upstream/rename/ ships: it is the engine an application runs as vendor/bin/adminata-rename
# (UPGRADE.md §10). The rest of upstream/ is sync tooling, kept out of the archive file by file,
# because an export-ignore on the directory could not be undone for the child.
/upstream/diff.sh export-ignore
/upstream/sync.sh export-ignore
/upstream/rehearse-sync.sh export-ignore
/upstream/exclude export-ignore
/upstream/remotes.txt export-ignore
/upstream/merged.txt export-ignore
/upstream/rename/README.md export-ignore
/vite.config.js export-ignore
/vitest.config.js export-ignore
/Makefile export-ignore
# The inherited upstream histories that CHANGELOG-sonata.md links. They are provenance, not
# something an installed package needs.
/changelog export-ignore
