{#
    What an `X-Requested-With` request gets back: a fragment, no `<html>`, no shell (PLAN/03 §A
    row 2). An application's own script parses `table.adminata-list` out of it — recomaty-panel's
    accordion does exactly that (appendix C §2) — so the list markup and the `adminata-list-table`
    marker stay where they were.
#}

{% block content %}
    {% set _list_table = block('list_table') is defined ? block('list_table')|trim : null %}
    {% set _list_filters = block('list_filters') is defined ? block('list_filters')|trim : null %}
    {% set _list_filters_actions = block('list_filters_actions') is defined ? block('list_filters_actions')|trim : null %}

    {% block preview %}{% endblock %}
    {% block form %}{% endblock %}
    {% block list %}{% endblock %}
    {% block show %}{% endblock %}

    {% if _list_table is not empty or _list_filters is not empty %}
        {% set _list_modes %}{% include '@Adminata/Core/list_mode_buttons.html.twig' %}{% endset %}

        {% if _list_modes|trim is not empty or _list_filters_actions is not empty %}
            <div class="adminata-list-table mb-4 flex flex-wrap items-center justify-between gap-3">
                {{ _list_modes|raw }}

                {% if _list_filters_actions is not empty %}
                    {{ _list_filters_actions|raw }}
                {% endif %}
            </div>
        {% endif %}

        {% if _list_filters|trim %}
            <div class="grid grid-cols-12 gap-4 md:gap-6">
                {{ _list_filters|raw }}
            </div>
        {% endif %}

        <div class="grid grid-cols-12 gap-4 md:gap-6">
            {{ _list_table|raw }}
        </div>
    {% endif %}
{% endblock %}
