{% extends "@Adminata/Block/block_core_rss.html.twig" %}

{% block block %}
    <div class="box box-warning">
        <div class="box-header with-border">
            <h3 class="box-title adminata-feed-title"><i class="fas fa-rss" aria-hidden="true"></i> {{ settings.title }}</h3>
        </div>

        <div class="adminata-feeds-container list-group">
            {% for feed in feeds %}
                <a class="list-group-item" href="{{ feed.link }}" rel="nofollow" title="{{ feed.title }}">
                    <strong>{{ feed.title }}</strong>
                    <div>{{ feed.description|raw }}</div>
                </a>
            {% else %}
                <div class="list-group-item">No feeds available.</div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
