{#
    The layout with everything but the content taken out: what a login or a password page extends
    (PLAN/01 T9).

    Upstream zeroed the content's padding with an inline `<style>`. A body class does the same
    thing and leaves the page free of inline styles, which is what a Content-Security-Policy
    without `style-src 'unsafe-inline'` needs.
#}

{% extends get_global_template('layout') %}

{% block adminata_header %}{% endblock %}
{% block adminata_left_side %}{% endblock %}
{% block adminata_nav %}{% endblock %}
{% block adminata_breadcrumb %}{% endblock %}
{% block adminata_overlay %}{% endblock %}

{% block body_attributes %}
    class="adm-shell adm-empty-layout"
    {{ stimulus_controller('adminata-layout')|stimulus_controller('adminata-sticky') }}
{% endblock %}

{% block adminata_wrapper %}
    {% block sonata_page_content %}
        {{ parent() }}
    {% endblock %}
{% endblock %}
