{#
    The page shell. The window scrolls, not an inner pane: `sonata-sticky` observes the viewport,
    and find-in-page lands where a reader expects (PLAN/01 T4).

    `<body>` is the shell element. It carries the layout state as `data-sidebar` and
    `data-sidebar-mobile`, seeded here from the `sonata_sidebar_hide` cookie so the first paint is
    already right, and the `sonata-layout` controller takes it from there. That is the direct
    successor of upstream's `sidebar-collapse` body class.
#}

{%- set _preview = block('preview') is defined ? block('preview')|trim : null %}
{% set _form = block('form') is defined ? block('form')|trim : null %}
{% set _show = block('show') is defined ? block('show')|trim : null %}
{% set _list_table = block('list_table') is defined ? block('list_table')|trim : null %}
{% set _list_filters = block('list_filters') is defined ? block('list_filters')|trim : null %}
{% set _tab_menu = block('tab_menu') is defined ? block('tab_menu')|trim : null %}
{% set _content = block('content') is defined ? block('content')|trim : null %}
{% set _title = block('title') is defined ? block('title')|trim : null %}
{% set _breadcrumb = block('breadcrumb') is defined ? block('breadcrumb')|trim : null %}
{% set _actions = block('actions') is defined ? block('actions')|trim : null %}
{% set _navbar_title = block('navbar_title') is defined ? block('navbar_title')|trim : null %}
{% set _list_filters_actions = block('list_filters_actions') is defined ? block('list_filters_actions')|trim : null %}
{% set _theme = sonata_theme() %}
{% set _sidebar_collapsed = app.request.cookies.get('sonata_sidebar_hide') ? true : false -%}
<!DOCTYPE html>
<html {% block html_attributes %}lang="{{ app.request.locale|split('_')|first }}" dir="{{ sonata_html_dir() }}" class="no-js{% if 'dark' == _theme %} dark{% endif %}" data-theme="{{ _theme }}"{% endblock %}>
    <head>
        {% block meta_tags %}
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
        {% endblock %}

        <meta name="sonata-config" content='{{ {
            CONFIRM_EXIT: sonata_config.getOption('confirm_exit'),
            USE_STICKYFORMS: sonata_config.getOption('use_stickyforms'),
            DEBUG: sonata_config.getOption('js_debug'),
        }|json_encode()|raw }}'
        >
        <meta name="sonata-translations" content='{{ {
            CONFIRM_EXIT: 'confirm_exit'|trans({}, 'SonataAdminBundle'),
        }|json_encode()|raw }}'
        >

        {% block stylesheets %}
            {% for stylesheet in sonata_config.getOption('stylesheets', []) %}
                <link rel="stylesheet" href="{{ asset(stylesheet.path, stylesheet.package_name) }}">
            {% endfor %}
        {% endblock %}

        {% block javascripts %}
            {% block sonata_javascript_config %}
            {% endblock %}

            {% block sonata_javascript_pool %}
                {% for javascript in sonata_config.getOption('javascripts', []) %}
                    <script src="{{ asset(javascript.path, javascript.package_name) }}" defer {{ block('sonata_script_attributes') }}></script>
                {% endfor %}
            {% endblock %}
        {% endblock %}

        {#
            Attributes every adminata `<script>` carries. Empty by default; an application under a
            strict Content-Security-Policy overrides it with its own `nonce`.
        #}
        {% block sonata_script_attributes %}{% endblock %}

        {#
            The only inline script adminata ships (PLAN/01 J4). `sonata_theme()` resolves the
            cookie server-side, but `system` is a question only the browser can answer, and asking
            it after the stylesheet has painted is a white flash on a dark desktop. Three lines,
            before the first paint, under the same nonce block as every other script.
        #}
        {% if 'system' == _theme %}
            <script {{ block('sonata_script_attributes') }}>
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.classList.add('dark');
                }
            </script>
        {% endif %}

        {#- Captured and collapsed: the block spans several lines and a `<title>` carrying the
            newlines between them reads as sixty characters of nothing. -#}
        {% set headTitle %}
        {% block sonata_head_title %}
            {{ 'Admin'|trans({}, 'SonataAdminBundle') }}

            {% if _title is not empty %}
                {{ _title|striptags|raw }}
            {% else %}
                {% if action is defined %}
                    -
                    {{ render_breadcrumbs_for_title(admin, action) }}
                {% endif %}
            {% endif %}
        {% endblock %}
        {% endset %}
        <title>{{ headTitle|u.collapseWhitespace }}</title>
    </head>
    <body
            {% block body_attributes -%}
                class="adm-shell"
                data-sidebar="{{ _sidebar_collapsed ? 'collapsed' : 'expanded' }}"
                data-sidebar-mobile="closed"
                {{ stimulus_controller('sonata-layout', {
                    collapsed: _sidebar_collapsed,
                    mobileOpen: false,
                    headerMenuOpen: false,
                    breakpoint: 1024,
                    cookieName: 'sonata_sidebar_hide',
                })|stimulus_controller('sonata-sticky') }}
            {%- endblock -%}
    >

        {#
            The first thing a keyboard reaches: everything before the content is the sidebar and
            the header, which is a long way to tab past on every page (PLAN/08 §8). Visible only
            while it has focus.
        #}
        <a class="adm-skip-link" href="#sonata-content">{{ 'skip_to_content'|trans({}, 'SonataAdminBundle') }}</a>

        {% block sonata_wrapper %}
            {% block sonata_left_side %}
                <aside class="adm-sidebar main-sidebar" {{ stimulus_target('sonata-layout', 'sidebar') }}>
                    <div class="adm-sidebar-header">
                        {% block logo %}
                            <a class="logo flex items-center gap-3" href="{{ path('sonata_admin_dashboard') }}">
                                {% if 'icon' == sonata_config.getOption('logo_content') or 'all' == sonata_config.getOption('logo_content') %}
                                    <img class="h-8 w-auto" src="{{ asset(sonata_config.logo) }}" alt="{{ sonata_config.title }}">
                                {% endif %}
                                {% if 'text' == sonata_config.getOption('logo_content') or 'all' == sonata_config.getOption('logo_content') %}
                                    <span class="menu-item-text text-lg font-semibold text-gray-800 dark:text-white/90">{{ sonata_config.title }}</span>
                                {% endif %}
                            </a>
                        {% endblock %}
                    </div>

                    <div class="adm-sidebar-nav no-scrollbar">
                        {% block sonata_side_nav %}
                            {#
                                Search moved to the header (`sonata_header_search`). The block stays
                                and stays empty: an application that overrides it to hide search
                                still hides it, and `sonata_header_search` renders nothing when this
                                one is empty.
                            #}
                            {% block sonata_sidebar_search %}{% endblock sonata_sidebar_search %}

                            {% block side_bar_before_nav %} {% endblock %}
                            {% block side_bar_nav %}
                                {{ knp_menu_render('sonata_admin_sidebar', {template: get_global_template('knp_menu_template')}) }}
                            {% endblock side_bar_nav %}
                            {% block side_bar_after_nav %}
                                {% set sideBarAfterNav = block('side_bar_after_nav_content') %}
                                {% if sideBarAfterNav|trim is not empty %}
                                    <div class="menu-item-text mt-auto mb-6 rounded-2xl bg-gray-50 px-4 py-5 text-center text-theme-sm text-gray-500 dark:bg-white/[0.03] dark:text-gray-400">
                                        {{ sideBarAfterNav|raw }}
                                    </div>
                                {% endif %}
                            {% endblock %}
                            {% block side_bar_after_nav_content %}{% endblock %}
                        {% endblock sonata_side_nav %}
                    </div>
                </aside>
            {% endblock sonata_left_side %}

            {#
                The scrim behind the mobile drawer. Hidden until `sonata-layout` opens the sidebar,
                and clicking it closes the drawer again.
            #}
            {% block sonata_overlay %}
                <div class="adm-overlay lg:hidden" hidden
                     {{ stimulus_target('sonata-layout', 'overlay') }}
                     {{ stimulus_action('sonata-layout', 'closeSidebar', 'click') }}
                ></div>
            {% endblock sonata_overlay %}

            <div class="adm-main" {{ stimulus_target('sonata-layout', 'content') }}>
                {% block sonata_header %}
                    {#
                        Nothing at all when both halves are empty: that is how an application's
                        login and password pages get a bare shell (PLAN/01 T9). `sonata_nav` is
                        captured rather than tested with `block()` so that the two `include()`s it
                        contains run once, not twice.
                    #}
                    {% set headerNav %}
                        {% block sonata_nav %}
                                <button type="button" class="sidebar-toggle adm-btn-icon adm-btn-icon-round lg:hidden"
                                        title="{{ 'toggle_navigation'|trans({}, 'SonataAdminBundle') }}"
                                        aria-label="{{ 'toggle_navigation'|trans({}, 'SonataAdminBundle') }}"
                                        aria-expanded="false"
                                        {{ stimulus_target('sonata-layout', 'toggle') }}
                                        {{ stimulus_action('sonata-layout', 'toggleSidebar', 'click') }}
                                >
                                    <i class="fas fa-bars" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="sidebar-toggle adm-btn-icon adm-btn-icon-round hidden lg:inline-flex"
                                        title="{{ 'toggle_navigation'|trans({}, 'SonataAdminBundle') }}"
                                        aria-label="{{ 'toggle_navigation'|trans({}, 'SonataAdminBundle') }}"
                                        aria-expanded="{{ _sidebar_collapsed ? 'false' : 'true' }}"
                                        {{ stimulus_target('sonata-layout', 'collapseOnly') }}
                                        {{ stimulus_action('sonata-layout', 'toggleCollapsed', 'click') }}
                                >
                                    <i class="fas fa-bars" aria-hidden="true"></i>
                                </button>

                                {#
                                    The sidebar search of upstream, in the place TailAdmin puts it.
                                    Silent when `sonata_sidebar_search` was overridden away, so one
                                    override still switches search off everywhere.
                                #}
                                {% block sonata_header_search %}
                                    {% if sonata_config.getOption('search') and block('sonata_sidebar_search')|trim is empty %}
                                        <form action="{{ path('sonata_admin_search') }}" method="GET" role="search" class="hidden lg:block">
                                            <label class="sr-only" for="sonata-search-input">{{ 'search_placeholder'|trans({}, 'SonataAdminBundle') }}</label>
                                            <input type="search" id="sonata-search-input" name="q"
                                                   value="{{ app.request.attributes.get('q', app.request.query.get('q', app.request.request.get('q'))) }}"
                                                   class="adm-input xl:w-[430px]"
                                                   placeholder="{{ 'search_placeholder'|trans({}, 'SonataAdminBundle') }}">
                                            {# Off-screen rather than absent: a search form has to be submittable without JavaScript. #}
                                            <button type="submit" class="sr-only">{{ 'search_placeholder'|trans({}, 'SonataAdminBundle') }}</button>
                                        </form>
                                    {% endif %}
                                {% endblock sonata_header_search %}

                                {% block sonata_top_nav_menu %}
                                    <ul class="ms-auto flex items-center gap-2">
                                        {% block sonata_top_nav_menu_dark_mode %}
                                            <li>
                                                <button type="button" class="adm-btn-icon adm-btn-icon-round"
                                                        {{ stimulus_controller('sonata-theme', {
                                                            theme: _theme,
                                                            cookieName: 'sonata_theme',
                                                            labels: {
                                                                light: 'theme_light'|trans({}, 'SonataAdminBundle'),
                                                                dark: 'theme_dark'|trans({}, 'SonataAdminBundle'),
                                                                system: 'theme_system'|trans({}, 'SonataAdminBundle'),
                                                            },
                                                        }) }}
                                                        {{ stimulus_action('sonata-theme', 'cycle', 'click') }}
                                                >
                                                    {# Both icons ship; the stylesheet shows the one the current theme calls for. #}
                                                    <i class="fas fa-moon hidden dark:inline-block" aria-hidden="true"></i>
                                                    <i class="fas fa-sun inline-block dark:hidden" aria-hidden="true"></i>
                                                </button>
                                            </li>
                                        {% endblock %}

                                        {% block sonata_top_nav_menu_add_block %}
                                            {% set addBlock = include(get_global_template('add_block')) %}
                                            {#- The guard is upstream's: an application that
                                                overrides `add_block` with an empty template hides
                                                the button too. -#}
                                            {% if addBlock|trim is not empty %}
                                                <li class="adm-dropdown"
                                                    {{ stimulus_controller('sonata-dropdown') }}
                                                    {{ stimulus_action('sonata-dropdown', 'closeAndFocus', 'keydown.esc')|stimulus_action('sonata-dropdown', 'navigate', 'keydown') }}
                                                >
                                                    <button type="button" class="adm-btn-icon adm-btn-icon-round"
                                                            aria-expanded="false"
                                                            aria-haspopup="menu"
                                                            aria-label="{{ 'link_add'|trans({}, 'SonataAdminBundle') }}"
                                                            {{ stimulus_target('sonata-dropdown', 'toggle') }}
                                                            {{ stimulus_action('sonata-dropdown', 'toggle', 'click') }}
                                                    >
                                                        <i class="fas fa-plus" aria-hidden="true"></i>
                                                    </button>
                                                    {{ addBlock|raw }}
                                                </li>
                                            {% endif %}
                                        {% endblock %}

                                        {% if app.user %}
                                            {% block sonata_top_nav_menu_user_block %}
                                                {#- The chrome is adminata's and shows whoever is
                                                    signed in; `user_block` fills the list under it.
                                                    Upstream hid the whole menu when that template
                                                    was empty, which is its default, so nobody saw
                                                    a user menu until an application wrote one. -#}
                                                {% set userBlock = include(get_global_template('user_block')) %}
                                                {% set userName = app.user.userIdentifier %}
                                                <li class="adm-dropdown user-menu"
                                                    {{ stimulus_controller('sonata-dropdown') }}
                                                    {{ stimulus_action('sonata-dropdown', 'closeAndFocus', 'keydown.esc')|stimulus_action('sonata-dropdown', 'navigate', 'keydown') }}
                                                >
                                                    <button type="button" class="adm-btn-icon adm-btn-icon-round"
                                                            aria-expanded="false"
                                                            aria-label="{{ userName }}"
                                                            {{ stimulus_target('sonata-dropdown', 'toggle') }}
                                                            {{ stimulus_action('sonata-dropdown', 'toggle', 'click') }}
                                                    >
                                                        <span aria-hidden="true">{{ userName|slice(0, 2)|upper }}</span>
                                                    </button>
                                                    <div class="adm-dropdown__menu" hidden {{ stimulus_target('sonata-dropdown', 'menu') }}>
                                                        <p class="px-3 py-2 text-theme-sm font-medium text-gray-700 dark:text-gray-300">{{ userName }}</p>
                                                        <ul class="dropdown-user">
                                                            {{ userBlock|raw }}
                                                        </ul>
                                                    </div>
                                                </li>
                                            {% endblock %}
                                        {% endif %}
                                    </ul>
                                {% endblock %}
                        {% endblock sonata_nav %}
                    {% endset %}

                    {% if block('logo')|trim is not empty or headerNav|trim is not empty %}
                        <header class="adm-header main-header" {{ stimulus_target('sonata-sticky', 'topNavbar') }}>
                            {% block sonata_header_noscript_warning %}
                                <noscript>
                                    <div class="noscript-warning adm-alert adm-alert-warning">
                                        {{ 'noscript_warning'|trans({}, 'SonataAdminBundle') }}
                                    </div>
                                </noscript>
                            {% endblock %}

                            {{ headerNav|raw }}
                        </header>
                    {% endif %}
                {% endblock sonata_header %}

                <main class="content-wrapper" id="sonata-content">
                    {% block sonata_page_content %}
                        <div class="adm-content">
                            {#
                                Captured rather than rendered in place: with neither a
                                breadcrumb nor a page header — the dashboard, an empty layout —
                                the wrapper would still take its margin, and a stray gap above
                                the content is the kind of thing nobody tracks down.
                            #}
                            {% set contentHeader %}
                                {% block sonata_breadcrumb %}
                                    {% if _breadcrumb is not empty or action is defined %}
                                        <nav aria-label="{{ 'breadcrumb'|trans({}, 'SonataAdminBundle') }}">
                                            <ol class="adm-breadcrumb breadcrumb">
                                                {% if _breadcrumb is empty %}
                                                    {% if action is defined %}
                                                        {{ render_breadcrumbs(admin, action) }}
                                                    {% endif %}
                                                {% else %}
                                                    {{ _breadcrumb|raw }}
                                                {% endif %}
                                            </ol>
                                        </nav>
                                    {% endif %}
                                {% endblock sonata_breadcrumb %}

                                {% block sonata_page_content_header %}
                                    {% block sonata_page_content_nav %}
                                        {% if _navbar_title is not empty
                                          or _tab_menu is not empty
                                          or _actions is not empty
                                          or _list_filters_actions is not empty
                                         %}
                                            <div class="adm-page-header mb-0" {{ stimulus_target('sonata-sticky', 'navbar') }}>
                                                {% block tab_menu_navbar_header %}
                                                    {% if _navbar_title is not empty %}
                                                        {#- `<h1>`: this is the page's own title,
                                                            and every page should have exactly
                                                            one. Upstream made it an anchor to
                                                            nowhere. -#}
                                                        <h1 class="adm-page-title">{{ _navbar_title|raw }}</h1>
                                                    {% endif %}
                                                {% endblock %}

                                                <div class="flex flex-wrap items-center gap-2">
                                                    {% if _tab_menu is not empty %}
                                                        <div class="sonata-tab-menu">
                                                            {{ _tab_menu|raw }}
                                                        </div>
                                                    {% endif %}

                                                    {% include '@SonataAdmin/Core/list_mode_buttons.html.twig' %}

                                                    {#
                                                        A button row, always. Upstream folded two or
                                                        more actions into a dropdown by counting
                                                        `</a>` in the captured string; that heuristic
                                                        is gone (PLAN/01 T7). The `<li>` pass-through
                                                        stays, because `Button/*.html.twig` and every
                                                        application override emit list items.
                                                    #}
                                                    {% block sonata_admin_content_actions_wrappers %}
                                                        {% if _actions|replace({ '<li>': '', '</li>': '' })|trim is not empty %}
                                                            <ul class="sonata-actions flex flex-wrap items-center gap-2">
                                                                {{ _actions|raw }}
                                                            </ul>
                                                        {% endif %}
                                                    {% endblock sonata_admin_content_actions_wrappers %}

                                                    {% if _list_filters_actions is not empty %}
                                                        {{ _list_filters_actions|raw }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endblock sonata_page_content_nav %}
                                {% endblock sonata_page_content_header %}
                            {% endset %}

                            {% if contentHeader|trim is not empty %}
                                <div class="content-header mb-6 flex flex-col gap-2">{{ contentHeader|raw }}</div>
                            {% endif %}

                            <div class="content">
                                {% block sonata_admin_content %}

                                    {% block notice %}
                                        {% include '@SonataAdmin/FlashMessage/render.html.twig' %}
                                    {% endblock notice %}

                                    {% if _preview is not empty %}
                                        <div class="sonata-ba-preview">{{ _preview|raw }}</div>
                                    {% endif %}

                                    {% if _content is not empty %}
                                        <div class="sonata-ba-content">{{ _content|raw }}</div>
                                    {% endif %}

                                    {% if _show is not empty %}
                                        <div class="sonata-ba-show">{{ _show|raw }}</div>
                                    {% endif %}

                                    {% if _form is not empty %}
                                        <div class="sonata-ba-form">{{ _form|raw }}</div>
                                    {% endif %}

                                    {#- The filter panel and the table share one grid, so that the
                                        `gap` puts air between them. Two sibling grids would each
                                        space their own children and leave the filter card sitting
                                        directly on the list card. Both blocks emit `col-span-12`
                                        children, and a hidden filter panel takes no grid track. -#}
                                    {% if _list_filters is not empty or _list_table is not empty %}
                                        <div class="grid grid-cols-12 gap-4 md:gap-6">
                                            {{ _list_filters|raw }}
                                            {{ _list_table|raw }}
                                        </div>
                                    {% endif %}
                                {% endblock sonata_admin_content %}
                            </div>
                        </div>
                    {% endblock sonata_page_content %}
                </main>
            </div>
        {% endblock sonata_wrapper %}

        {#- The shared dialog sits outside `sonata_wrapper` on purpose: an application that
            overrides the wrapper keeps it, and one that wants none overrides this block. -#}
        {% block sonata_dialog %}
            {{ include('@SonataAdmin/Core/dialog.html.twig') }}
            {{ include('@SonataAdmin/Core/question_dialog.html.twig') }}
        {% endblock sonata_dialog %}
    </body>
</html>
