{#
    The ARIA 1.2 combobox the `sonata-autocomplete` controller drives (PLAN/06 §3). select2 and its
    four blocks of generated JavaScript are gone; what stayed is the wire contract: the request the
    server answers, `#{{ id }}_autocomplete_input`, and `#{{ id }}_hidden_inputs_wrap`, whose inputs
    are the only thing this widget submits.
#}
{%- set autocomplete_id = id ~ '_autocomplete_input' -%}
{%- set autocomplete_labels = value['_labels']|default({}) -%}
{%- set autocomplete_selected = [] -%}
{%- for index, identifier in value|filter((identifier, index) => index ~ '' != '_labels') -%}
    {%- set autocomplete_selected = autocomplete_selected|merge([{
        id: identifier,
        label: autocomplete_labels[index]|default(identifier),
    }]) -%}
{%- endfor -%}
{%- set autocomplete_first = autocomplete_selected|first|default({}) -%}

{#
    The name of the listbox. Whoever rendered the widget knows the field's label — the filter panel
    calls a filter on two form children `value`, which is not what it shows beside the box — so it
    may pass one in; the input itself is named by the `<label for>` that caller writes.
#}
{%- set autocomplete_label = autocomplete_label|default(null) -%}
{%- if autocomplete_label is empty -%}
    {%- set autocomplete_label = label is empty ? name|humanize : label -%}
    {%- if translation_domain is not same as(false) -%}
        {%- set autocomplete_label = autocomplete_label|trans(
            label_translation_parameters|default({}),
            sonata_admin.admin
                ? sonata_admin.field_description.translationDomain|default(sonata_admin.admin.translationDomain)
                : translation_domain
        ) -%}
    {%- endif -%}
{%- endif -%}

{#
    The request parameters the action needs beside the term and the page. Captured rather than
    printed: a `{% block %}` renders where it stands, and this one belongs in an attribute. What
    the block writes is escaped for that attribute exactly once, so an override needs nothing but
    a `json_encode`.
#}
{%- set autocomplete_request_parameters_json %}{% block sonata_type_model_autocomplete_ajax_request_parameters -%}
    {%- set autocomplete_request_parameters = {} -%}
    {%- if sonata_admin.admin -%}
        {%- set autocomplete_request_parameters = {
            uniqid: sonata_admin.admin.uniqid,
            _sonata_admin: sonata_admin.admin.baseCodeRoute,
        } -%}
    {%- elseif admin_code -%}
        {%- set autocomplete_request_parameters = {_sonata_admin: admin_code} -%}
    {%- endif -%}
    {%- if context == 'filter' -%}
        {%- set autocomplete_request_parameters = autocomplete_request_parameters|merge({
            field: full_name|replace({'filter[': '', '][value]': '', '__': '.'}),
            _context: 'filter',
        }) -%}
    {%- else -%}
        {%- set autocomplete_request_parameters = autocomplete_request_parameters|merge({field: name}) -%}
    {%- endif -%}
    {{- autocomplete_request_parameters|merge(req_params)|json_encode -}}
{%- endblock %}{% endset -%}

<div class="adm-combobox {{ container_css_class }}"
     data-controller="sonata-autocomplete"
     data-sonata-autocomplete-url-value="{{ url ?: path(route.name, route.parameters|default([])) }}"
     data-sonata-autocomplete-request-parameters-value="{{ autocomplete_request_parameters_json }}"
     data-sonata-autocomplete-search-parameter-value="{{ req_param_name_search }}"
     data-sonata-autocomplete-page-parameter-value="{{ req_param_name_page_number }}"
     data-sonata-autocomplete-per-page-parameter-value="{{ req_param_name_items_per_page }}"
     data-sonata-autocomplete-min-length-value="{{ minimum_input_length }}"
     data-sonata-autocomplete-per-page-value="{{ items_per_page }}"
     {# NEXT_MAJOR: Replace by `delay` once `quiet_millis` is removed. #}
     data-sonata-autocomplete-delay-value="{{ delay == 100 and quiet_millis != 100 ? quiet_millis : delay }}"
     data-sonata-autocomplete-multiple-value="{{ multiple ? 'true' : 'false' }}"
     data-sonata-autocomplete-name-value="{{ full_name }}"
     data-sonata-autocomplete-safe-label-value="{{ safe_label|default(false) ? 'true' : 'false' }}"
     data-sonata-autocomplete-disabled-value="{{ disabled ? 'true' : 'false' }}"
     data-sonata-autocomplete-selected-value="{{ autocomplete_selected|json_encode }}"
     data-sonata-autocomplete-min-length-text-value="{{ 'autocomplete_input_too_short'|trans({}, 'SonataAdminBundle') }}"
     data-sonata-autocomplete-no-results-text-value="{{ 'no_results_found'|trans({}, 'SonataAdminBundle') }}"
     data-sonata-autocomplete-loading-text-value="{{ 'loading_information'|trans({}, 'SonataAdminBundle') }}"
     data-sonata-autocomplete-more-text-value="{{ 'autocomplete_load_more'|trans({}, 'SonataAdminBundle') }}"
     data-sonata-autocomplete-remove-text-value="{{ 'autocomplete_remove'|trans({}, 'SonataAdminBundle') }}"
>
    {%- if multiple %}
        <ul class="adm-combobox__chips" data-sonata-autocomplete-target="chips"></ul>
    {% endif -%}

    <input type="text" id="{{ autocomplete_id }}" class="adm-input {{ attr.class|default('') }}"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="false"
           aria-controls="{{ id }}_listbox"
           autocomplete="off"
           value="{{ multiple ? '' : autocomplete_first.label|default('')|striptags }}"
           {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
           {%- if disabled %} disabled="disabled"{% endif %}
           data-sonata-autocomplete-target="input"
           data-action="input->sonata-autocomplete#search keydown->sonata-autocomplete#navigate"
           {%- for attribute, attribute_value in attr|filter((attribute_value, attribute) => attribute != 'class') %} {{ attribute }}="{{ attribute_value }}"{% endfor %}>

    <ul class="adm-combobox__listbox {{ dropdown_css_class }}"
        id="{{ id }}_listbox"
        role="listbox"
        aria-label="{{ autocomplete_label }}"
        hidden
        data-sonata-autocomplete-target="listbox"></ul>

    <div class="adm-combobox__status" role="status" data-sonata-autocomplete-target="status"></div>

    {#- A Stimulus target has to live inside the controller's element; the identifier is what an
        application selects on, and it has not moved. -#}
    <div id="{{ id }}_hidden_inputs_wrap" data-sonata-autocomplete-target="hiddenInputs">
        {%- if multiple -%}
            {%- for item in autocomplete_selected -%}
                <input type="hidden" name="{{ full_name }}[]"{% if disabled %} disabled="disabled"{% endif %} value="{{ item.id }}">
            {%- endfor -%}
        {%- else -%}
            <input type="hidden" name="{{ full_name }}"{% if disabled %} disabled="disabled"{% endif %} value="{{ autocomplete_first.id|default('') }}">
        {%- endif -%}
    </div>

    <template data-sonata-autocomplete-target="itemTemplate">
        {%- block sonata_type_model_autocomplete_dropdown_item_format -%}
            <li class="adm-combobox__option {{ dropdown_item_css_class }}" data-action="click->sonata-autocomplete#pick"></li>
        {%- endblock -%}
    </template>

    <template data-sonata-autocomplete-target="chipTemplate">
        {%- block sonata_type_model_autocomplete_selection_format -%}
            <li class="adm-chip"><span data-label></span><button type="button" class="adm-chip__remove" data-remove data-action="sonata-autocomplete#remove" aria-label="{{ 'autocomplete_remove'|trans({}, 'SonataAdminBundle') }}"><span aria-hidden="true">&times;</span></button></li>
        {%- endblock -%}
    </template>
</div>

{%- if sonata_admin.field_description and sonata_admin.field_description.hasAssociationAdmin %}
    {#
        Upstream opened the association's create form in a modal over `ajaxSubmit`. Both are gone
        (PLAN/01 J2, owner directive 5), so until the post-1.0 `sonata-association` controller lands
        this is a plain link to the create page.
    #}
    {%- set autocomplete_btn_add = sonata_admin.edit != 'admin'
        and sonata_admin.field_description.associationadmin.hasRoute('create')
        and sonata_admin.field_description.associationadmin.isGranted('CREATE')
        and btn_add -%}
    {%- if autocomplete_btn_add -%}
        {%- set autocomplete_btn_label = btn_translation_domain|default(null) is same as(false)
            ? btn_add
            : btn_add|trans({}, btn_translation_domain|default(btn_catalogue)) -%}
        <div id="field_actions_{{ id }}" class="field-actions">
            <a href="{{ sonata_admin.field_description.associationadmin.generateUrl(
                   'create',
                   sonata_admin.field_description.getOption('link_parameters', {})
               ) }}"
               class="adm-btn adm-btn-sm adm-btn-success sonata-ba-action"
               title="{{ autocomplete_btn_label }}">
                <i class="fas fa-plus-circle" aria-hidden="true"></i>
                {{ autocomplete_btn_label }}
            </a>
        </div>
    {%- endif -%}
{%- endif -%}
