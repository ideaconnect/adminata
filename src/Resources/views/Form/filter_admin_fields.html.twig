{#
    The filter theme (PLAN/06 §1, PLAN/01 F2).

    Native controls with adminata's recipes on them, in place of the Bootstrap `form-control` and
    the `.checkbox` / `.radio` wrappers upstream inherited from MopaBootstrapBundle. Date and
    date-time filters keep Symfony's HTML5 `single_text` widgets — `type=date` and
    `type=datetime-local` — which need no picker library and which the browser localises itself.

    Attributes an application sets on a filter field, `data-controller` among them, pass through
    untouched: every block merges into `attr` rather than replacing it, which is what lets a
    ux-autocomplete `<select>` keep working inside the panel.
#}

{% extends 'form_div_layout.html.twig' %}

{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {#- Idempotent: `datepicker.html.twig` applies the recipe itself so that a plain form rendered
        without a Sonata theme still gets it. -#}
    {% set recipe = type in ['checkbox', 'radio', 'hidden', 'file'] or 'adm-input' in attr.class|default('')
        ? ''
        : 'adm-input' %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ recipe)|trim}) %}
    {{ parent() }}
{% endblock form_widget_simple %}

{% block textarea_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' adm-textarea')|trim}) %}
    {{ parent() }}
{% endblock textarea_widget %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' adm-select' ~ (multiple ? ' adm-select-multiple' : ''))|trim}) %}
    {{ parent() }}
{% endblock choice_widget_collapsed %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }} class="flex flex-wrap items-center gap-3">
        {% for child in form %}
            <label class="{{ multiple ? 'adm-checkbox-label' : 'adm-radio-label' }}">
                {{ form_widget(child) }}
                {{ child.vars.label|trans({}, translation_domain) }}
            </label>
        {% endfor %}
    </div>
{% endblock choice_widget_expanded %}

{% block checkbox_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' adm-checkbox')|trim}) %}
    {{ parent() }}
{% endblock checkbox_widget %}

{% block radio_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' adm-radio')|trim}) %}
    {{ parent() }}
{% endblock radio_widget %}

{#
    Additive (PLAN/02 §5). A range filter is two `single_text` date inputs; upstream stacked them
    through `form_div_layout`, which puts each on its own row and loses which is which.
#}
{% block sonata_type_date_range_widget %}
    {#- `widget_container_attributes` keeps the container's own id, which is what the filter row's
        `<label for>` points at. -#}
    <div {{ block('widget_container_attributes') }} class="grid grid-cols-2 gap-2">
        {% for child in form %}
            <div>
                {#- Each half needs a name of its own; the row's label names the filter, not the
                    end of the range it belongs to. -#}
                {{ form_widget(child, {'attr': child.vars.attr|default({})|merge({
                    'aria-label': (child.vars.label ?? child.vars.name)|trans({}, translation_domain),
                })}) }}
            </div>
        {% endfor %}
    </div>
{% endblock sonata_type_date_range_widget %}

{% block sonata_type_datetime_range_widget %}
    {{ block('sonata_type_date_range_widget') }}
{% endblock sonata_type_datetime_range_widget %}

{% block sonata_type_model_autocomplete_widget %}
    {% include template %}
{% endblock sonata_type_model_autocomplete_widget %}
