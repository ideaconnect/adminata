{#
    The admin form theme (PLAN/06 §1).

    Bootstrap's `form-group`, `has-error`, `help-block`, `control-label` and `col-sm-*` are gone;
    the hooks PLAN/02 §8 lists — `#adminata-field-container-{id}`, `adminata-field`,
    `adminata-field-{edit}-{inline}`, `adminata-field-error`, `adminata-field-error-messages`,
    `adminata-field-help`, `control-label__text` and `required` — are not.

    Every widget block *appends* to `attr.class` and never replaces it, so an application's own
    `attr` — `data-controller` included — reaches the page untouched.

    Five variables let a caller add to the recipes without overriding a block:
    `row_class`, `label_class`, `widget_class`, `help_class` and `error_item_class`.
#}
{% extends 'form_div_layout.html.twig' %}

{% block form_errors -%}
    {% if errors|length > 0 %}
        {# The form's own errors are an alert; a field's are the message list under the control. #}
        {% if not form.parent %}<div class="adm-alert adm-alert-error" role="alert">{% endif %}
            <ul class="adm-error-list">
                {% for error in errors %}
                    <li{% if error_item_class|default('') is not empty %} class="{{ error_item_class }}"{% endif %}><i class="fas fa-circle-exclamation" aria-hidden="true"></i> {{ error.message }}</li>
                {% endfor %}
            </ul>
        {% if not form.parent %}</div>{% endif %}
    {% endif %}
{%- endblock form_errors %}

{% block form_help -%}
    {% if adminata_admin_translation_domain is defined and translation_domain is null %}
        {% set translation_domain = adminata_admin_translation_domain %}
    {% endif %}
    {% if help is not empty %}
        {# `parent()` is what keeps `help_html` rendering as markup. #}
        {% set help_attr = help_attr|merge({class: [
            help_attr.class|default(''),
            'adm-help adminata-field-help',
            help_class|default(''),
        ]|filter(part => part is not empty)|join(' ')}) %}
        {{ parent() }}
    {% endif %}
{%- endblock form_help %}

{#
    Append-only: `form_div_layout` writes the id, the name, `required`, `disabled` and everything
    in `attr`, and this adds one attribute the theme knows and the caller cannot — that the control
    is the one the error list belongs to.
#}
{% block widget_attributes -%}
    {{- parent() -}}
    {%- if errors|default([])|length > 0 and attr['aria-invalid'] is not defined %} aria-invalid="true"{% endif -%}
{%- endblock widget_attributes %}

{#
    `form_div_layout` has no `file_widget`: a file field is `form_widget_simple` with `type=file`,
    which is why the TailAdmin recipe for it is chosen here rather than in a block of its own.
    `hidden` has nothing to style, and `checkbox` and `radio` reach this block only through a theme
    that has not overridden them.
#}
{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {% if 'file' == type %}
        {% set attr = attr|merge({'class': [
            attr.class|default(''),
            'adm-file',
            widget_class|default(''),
        ]|filter(part => part is not empty)|join(' ')}) %}
    {% elseif type not in ['hidden', 'checkbox', 'radio'] %}
        {#- Idempotent: the date picker template applies the recipe itself, so that a plain form
            rendered without this theme still gets it. -#}
        {% set attr = attr|merge({'class': [
            attr.class|default(''),
            'adm-input' in attr.class|default('') ? '' : 'adm-input',
            widget_class|default(''),
            errors|default([])|length > 0 ? 'adm-input-error' : '',
        ]|filter(part => part is not empty)|join(' ')}) %}
    {% endif %}
    {{ parent() }}
{% endblock form_widget_simple %}

{#
    A password field an administrator fills in is someone else's, so the browser must not offer the
    administrator's own: `new-password` is the value that says so. An application that means
    something else sets `attr.autocomplete` and this leaves it alone.
#}
{% block password_widget -%}
    {%- if attr.autocomplete is not defined -%}
        {%- set attr = attr|merge({autocomplete: 'new-password'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock password_widget %}

{% block textarea_widget %}
    {% set attr = attr|merge({'class': [
        attr.class|default(''),
        'adm-textarea',
        widget_class|default(''),
        errors|default([])|length > 0 ? 'adm-input-error' : '',
    ]|filter(part => part is not empty)|join(' ')}) %}
    {{ parent() }}
{% endblock textarea_widget %}

{% block money_widget -%}
    {% if money_pattern == '{{ widget }}' %}
        {{- block('form_widget_simple') -}}
    {% else %}
        {% set currencySymbol = money_pattern|replace({'{{ widget }}': ''})|trim %}
        {% if money_pattern matches '/^{{ widget }}/' %}
            <div class="adm-input-group">
                {{- block('form_widget_simple') -}}
                <span class="adm-input-affix">{{ currencySymbol }}</span>
            </div>
        {% elseif money_pattern matches '/{{ widget }}$/' %}
            <div class="adm-input-group">
                <span class="adm-input-affix">{{ currencySymbol }}</span>
                {{- block('form_widget_simple') -}}
            </div>
        {% endif %}
    {% endif %}
{%- endblock money_widget %}

{% block percent_widget %}
    {% set type = type|default('text') %}
    <div class="adm-input-group">
        {{- block('form_widget_simple') -}}
        <span class="adm-input-affix">%</span>
    </div>
{% endblock percent_widget %}

{#
    A checkbox is its label: `adm-checkbox-label` is the flex row that holds the box and the text,
    so Bootstrap's wrapping `<div class="checkbox">` — and the `checkbox-inline` special case that
    escaped it — have nothing left to do.
#}
{% block checkbox_widget -%}
    {%- set attr = attr|merge({'class': [
        attr.class|default(''),
        'adm-checkbox',
        widget_class|default(''),
    ]|filter(part => part is not empty)|join(' ')}) -%}
    {{- form_label(form, null, { widget: parent() }) -}}
{%- endblock checkbox_widget %}

{% block radio_widget -%}
    {%- set attr = attr|merge({'class': [
        attr.class|default(''),
        'adm-radio',
        widget_class|default(''),
    ]|filter(part => part is not empty)|join(' ')}) -%}
    {{- form_label(form, null, { widget: parent() }) -}}
{%- endblock radio_widget %}

{# Labels #}
{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({'class': [
            label_attr.class|default(''),
            'adm-label',
            label_class|default(''),
            adminata_admin.options['form_type'] == 'horizontal' ? 'col-span-12 mb-0 md:col-span-3 md:pt-2.5' : '',
            required ? 'required' : '',
        ]|filter(part => part is not empty)|join(' ')}) %}

        {#- The autocomplete widget's control is the combobox it draws, and it draws one whether or
            not the field is compound. -#}
        {% if 'adminata_type_model_autocomplete' in block_prefixes %}
            {% set label_attr = label_attr|merge({'for': id ~ '_autocomplete_input'}) %}
        {% elseif not compound %}
            {% set label_attr = label_attr|merge({'for': id}) %}
        {% endif %}

        {% if label is empty %}
            {%- if label_format is defined and label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {% endif %}

        <label{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>
            {%- if translation_domain is same as(false) -%}
                {{- label -}}
            {%- elseif not adminata_admin.admin -%}
                {{- label|trans(label_translation_parameters, translation_domain) -}}
            {%- else -%}
                {{- label|trans(label_translation_parameters, adminata_admin.field_description.translationDomain|default(adminata_admin.admin.translationDomain)) -}}
            {%- endif -%}
            {#- The control already carries `required`, which is what a screen reader announces; the
                asterisk is for everyone else. -#}
            {%- if required %}<span class="adm-required" aria-hidden="true">*</span>{% endif -%}
        </label>
    {% endif %}
{% endblock form_label %}

{% block checkbox_label -%}
    {{- block('checkbox_radio_label') -}}
{%- endblock checkbox_label %}

{% block radio_label -%}
    {{- block('checkbox_radio_label') -}}
{%- endblock radio_label %}

{% block checkbox_radio_label %}
    {% if adminata_admin.admin %}
        {% set translation_domain = adminata_admin.field_description.translationDomain %}
    {% endif %}
    {# Do not display the label if widget is not defined in order to prevent double label rendering #}
    {% if widget is defined %}
        {% set label_attr = label_attr|merge({class: [
            label_attr.class|default(''),
            'radio' in block_prefixes ? 'adm-radio-label' : 'adm-checkbox-label',
            label_class|default(''),
            required ? 'required' : '',
        ]|filter(part => part is not empty)|join(' ')}) %}
        {% if label is not same as(false) and label is empty %}
            {% set label = name|humanize %}
        {% endif %}
        <label{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>
            {{- widget|raw -}}
            {%- if label is not same as(false) -%}
                <span class="control-label__text">
                    {% if translation_domain is same as(false) %}
                        {{- label -}}
                    {% else %}
                        {{- label|trans(label_translation_parameters, translation_domain) -}}
                    {%- endif -%}
                </span>
            {%- endif -%}
        </label>
    {% endif %}
{% endblock checkbox_radio_label %}

{% block choice_widget_expanded %}
    {% set attr = attr|merge({'class': [
        attr.class|default(''),
        'adm-choice-list',
    ]|filter(part => part is not empty)|join(' ')}) %}
    <ul {{ block('widget_container_attributes') }}>
    {% for child in form %}
        <li>
            {{ form_widget(child, {'translation_domain': choice_translation_domain}) }}
        </li>
    {% endfor %}
    </ul>
{% endblock choice_widget_expanded %}

{% block choice_widget_collapsed %}
    {% if required and placeholder is defined and placeholder is none %}
        {% set required = false %}
    {% elseif required and empty_value is defined and empty_value_in_choices is defined and empty_value is none and not empty_value_in_choices and not multiple %}
        {% set required = false %}
    {% endif %}

    {#- Native, always: `use_select2` is gone with jQuery, and the placeholder it used to hand a
        plugin is an empty `<option>` again (PLAN/01 J6). -#}
    {% set attr = attr|merge({'class': [
        attr.class|default(''),
        'adm-select',
        multiple ? 'adm-select-multiple' : '',
        widget_class|default(''),
        errors|default([])|length > 0 ? 'adm-input-error' : '',
    ]|filter(part => part is not empty)|join(' ')}) %}

    <select {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>
        {% if empty_value is defined and empty_value is not none %}
            <option value=""{% if required and value is empty %} selected="selected"{% endif %}>
                {% if empty_value != '' %}
                    {% if not adminata_admin.admin %}
                        {{- empty_value|trans({}, translation_domain) -}}
                    {% else %}
                        {{- empty_value|trans({}, adminata_admin.field_description.translationDomain) -}}
                    {% endif %}
                {% endif %}
            </option>
        {% elseif placeholder is defined and placeholder is not none %}
            <option value=""{% if required and value is empty %} selected="selected"{% endif %}>
                {%- if placeholder != '' -%}
                    {%- if not adminata_admin.admin -%}
                        {{- placeholder|trans({}, translation_domain) -}}
                    {%- else -%}
                        {{- placeholder|trans({}, adminata_admin.field_description.translationDomain) -}}
                    {%- endif -%}
                {%- endif -%}
            </option>
        {% endif %}
        {% if preferred_choices|length > 0 %}
            {% set options = preferred_choices %}
            {{ block('choice_widget_options') }}
            {% if choices|length > 0 %}
                <option disabled="disabled">{{ separator }}</option>
            {% endif %}
        {% endif %}
        {% set options = choices %}
        {{ block('choice_widget_options') }}
    </select>
{% endblock choice_widget_collapsed %}

{#
    `single_text` is a native `<input type="date|time|datetime-local">` and is the shape adminata
    uses everywhere (PLAN/06 §4). The multi-select fallbacks stay for the forms that ask for them;
    the Bootstrap grid they sat in is a flex row now.
#}
{% block date_widget %}
    {% if widget == 'single_text' %}
        {{ block('form_widget_simple') }}
    {% else %}
        {% if row is not defined or row == true %}
            {% set attr = attr|merge({'class': (attr.class|default('') ~ ' flex flex-wrap gap-2')|trim}) %}
        {% endif %}
        {% set input_wrapper_class = input_wrapper_class|default('min-w-24 flex-1') %}
        <div {{ block('widget_container_attributes') }}>
            {{ date_pattern|replace({
                '{{ year }}':  '<div class="'~ input_wrapper_class ~ '">' ~ form_widget(form.year) ~ '</div>',
                '{{ month }}': '<div class="'~ input_wrapper_class ~ '">' ~ form_widget(form.month) ~ '</div>',
                '{{ day }}':   '<div class="'~ input_wrapper_class ~ '">' ~ form_widget(form.day) ~ '</div>',
            })|raw }}
        </div>
    {% endif %}
{% endblock date_widget %}

{% block time_widget %}
    {% if widget == 'single_text' %}
        {{ block('form_widget_simple') }}
    {% else %}
        {% if row is not defined or row == true %}
            {% set attr = attr|merge({'class': (attr.class|default('') ~ ' flex flex-wrap gap-2')|trim}) %}
        {% endif %}
        {% set input_wrapper_class = input_wrapper_class|default('min-w-20 flex-1') %}
        <div {{ block('widget_container_attributes') }}>
            <div class="{{ input_wrapper_class }}">
                {{ form_widget(form.hour) }}
            </div>
            {% if with_minutes %}
                <div class="{{ input_wrapper_class }}">
                    {{ form_widget(form.minute) }}
                </div>
            {% endif %}
            {% if with_seconds %}
                <div class="{{ input_wrapper_class }}">
                    {{ form_widget(form.second) }}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock time_widget %}

{% block datetime_widget %}
    {% if widget == 'single_text' %}
        {{ block('form_widget_simple') }}
    {% else %}
        {% set attr = attr|merge({'class': (attr.class|default('') ~ ' flex flex-wrap items-start gap-2')|trim}) %}
        <div {{ block('widget_container_attributes') }}>
            {{ form_errors(form.date) }}
            {{ form_errors(form.time) }}

            {% if form.date.vars.widget == 'single_text' %}
                <div class="min-w-40 flex-1">
                    {{ form_widget(form.date) }}
                </div>
            {% else %}
                {{ form_widget(form.date, {'row': false, 'input_wrapper_class': 'min-w-24 flex-1'}) }}
            {% endif %}

            {% if form.time.vars.widget == 'single_text' %}
                <div class="min-w-32 flex-1">
                    {{ form_widget(form.time) }}
                </div>
            {% else %}
                {{ form_widget(form.time, {'row': false, 'input_wrapper_class': 'min-w-20 flex-1'}) }}
            {% endif %}
        </div>
    {% endif %}
{% endblock datetime_widget %}

{% block form_row %}
    {% set show_label = show_label ?? true %}
    {% set horizontal = adminata_admin is defined and adminata_admin.options['form_type'] == 'horizontal' %}
    {% set row_id = 'adminata-field-container-'~id %}
    {% set row_class = [
        row_attr.class|default(''),
        'adm-form-row',
        row_class|default(''),
        horizontal ? 'grid grid-cols-12 items-start gap-x-3 gap-y-1' : '',
    ]|filter(part => part is not empty)|join(' ') %}
    <div{% with {attr: row_attr|merge({id: row_id, class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {% set div_class = 'adminata-field' %}

        {% if label is same as(false) %}
            {% set div_class = div_class ~ ' adminata-collection-row-without-label' %}
        {% endif %}

        {% if horizontal %}
            {#- Nine of the twelve columns, and the whole width when there is no label to sit
                beside: an empty label column is space nothing uses. -#}
            {% if label is same as(false) or form.vars.checked is defined %}
                {% if 'collection' in form.parent.vars.block_prefixes %}
                    {% set div_class = div_class ~ ' col-span-12' %}
                {% else %}
                    {% set div_class = div_class ~ ' col-span-12 md:col-span-9 md:col-start-4' %}
                {% endif %}
            {% else %}
                {% set div_class = div_class ~ ' col-span-12 md:col-span-9' %}
            {% endif %}
        {% endif %}

        {% if show_label %}
            {{ form_label(form, label|default(null), {label_class: label_class|default('')}) }}
        {% endif %}

        {% if adminata_admin is defined and adminata_admin_enabled %}
            {% set div_class = div_class ~ ' adminata-field-' ~ adminata_admin.edit ~ '-' ~ adminata_admin.inline %}
        {% endif %}

        {% if errors|length > 0 %}
            {% set div_class = div_class ~ ' adminata-field-error' %}
        {% endif %}

        <div class="{{ div_class }}">
            {#- Forwarded, not inherited: `form_widget` and the rest start from the view's own
                variables, so a class passed to `form_row` reaches them only by being passed on. -#}
            {{ form_widget(form, {widget_class: widget_class|default('')}) }}

            {% if errors|length > 0 %}
                <div class="mt-1.5 adminata-field-error-messages">
                    {{ form_errors(form, {error_item_class: error_item_class|default('')}) }}
                </div>
            {% endif %}

            {{ form_help(form, {help_class: help_class|default('')}) }}
        </div>
    </div>
{% endblock form_row %}

{% block checkbox_row -%}
    {% set show_label = false %}
    {{ block('form_row') }}
{%- endblock checkbox_row %}

{% block radio_row -%}
    {% set show_label = false %}
    {{ block('form_row') }}
{%- endblock radio_row %}

{#
    A collection row is a card (PLAN/06 §2). `adminata-collection-row`, `adminata-collection-delete`,
    `adminata-collection-add`, `data-prototype` and `data-prototype-name` are the contract; the icon
    buttons carry a name, because an icon is not one.
#}
{% block adminata_type_native_collection_widget_row %}
    <div class="adm-collection-row adminata-collection-row" {{ stimulus_target('adminata-collection', 'item') }}>
        {% if allow_delete %}
            <div class="flex items-start gap-3">
                <div class="min-w-0 flex-1">
        {% endif %}
            {{ form_row(child, { label: false }) }}
        {% if allow_delete %}
                </div>
                <button type="button"
                        class="adm-btn-icon adm-btn-icon-delete adminata-collection-delete"
                        {{ stimulus_action('adminata-collection', 'delete', 'click') }}>
                    <i class="fas fa-circle-minus" aria-hidden="true"></i>
                    <span class="sr-only">{{ 'link_delete'|trans({}, 'AdminataBundle') }}</span>
                </button>
            </div>
        {% endif %}
    </div>
{% endblock adminata_type_native_collection_widget_row %}

{% block adminata_type_native_collection_widget %}
    {% if prototype is defined %}
        {% set child = prototype %}
        {% set allow_delete_backup = allow_delete %}
        {% set allow_delete = true %}
        {% set attr = attr|merge({
            'data-prototype': block('adminata_type_native_collection_widget_row'),
            'data-prototype-name': prototype.vars.name,
            'class': [attr.class|default(''), 'adm-collection']|filter(part => part is not empty)|join(' '),
        })|merge(stimulus_controller('adminata-collection').toArray()) %}
        {% set allow_delete = allow_delete_backup %}
    {% endif %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form %}
            {{ block('adminata_type_native_collection_widget_row') }}
        {% endfor %}
        {{ form_rest(form) }}
        {% if allow_add %}
            <button type="button"
                    class="adm-btn adm-btn-secondary adm-btn-sm adminata-collection-add"
                    {{ stimulus_action('adminata-collection', 'add', 'click') }}>
                <i class="fas fa-circle-plus" aria-hidden="true"></i>
                {{ 'link_add'|trans({}, 'AdminataBundle') }}
            </button>
        {% endif %}
    </div>
{% endblock adminata_type_native_collection_widget %}

{% block adminata_type_immutable_array_widget %}
    <div {{ block('widget_container_attributes') }}>
        {% for key, child in form %}
            {{ block('adminata_type_immutable_array_widget_row') }}
        {% endfor %}

        {{ form_rest(form) }}
    </div>
{% endblock adminata_type_immutable_array_widget %}

{% block adminata_type_immutable_array_widget_row %}
    {% set horizontal = adminata_admin.options['form_type'] == 'horizontal' %}
    <div class="adm-form-row{% if horizontal %} grid grid-cols-12 items-start gap-x-3 gap-y-1{% endif %}"
         id="adminata-field-container-{{ id }}-{{ key }}">

        {{ form_label(child) }}

        <div class="{% if horizontal %}col-span-12 md:col-span-9 {% endif %}adminata-field adminata-field-{{ adminata_admin.edit }}-{{ adminata_admin.inline }}{% if child.vars.errors|length > 0 %} adminata-field-error{% endif %}">
            {{ form_widget(child) }}

            {% if child.vars.errors|length > 0 %}
                <div class="mt-1.5 adminata-field-error-messages">
                    {{ form_errors(child) }}
                </div>
            {% endif %}

            {{ form_help(child) }}
        </div>
    </div>
{% endblock %}

{% block adminata_type_model_autocomplete_widget %}
    {% include template %}
{% endblock adminata_type_model_autocomplete_widget %}

{#
    Markup only. Upstream printed a page of jQuery here that showed and hid other fields as the
    choice changed; the `adminata-choice-field-mask` controller that replaces it is post-1.0
    (PLAN/01 J2), so until then every field the map governs simply stays visible. What the future
    controller needs — the map and the full list — is on the element already.
#}
{% block adminata_type_choice_field_mask_widget %}
    {% set main_form_name = id|slice(0, (id|length - name|length) - 1) %}
    <div class="adminata-choice-field-mask"
         data-adminata-choice-field-mask-form="{{ main_form_name }}"
         data-adminata-choice-field-mask-fields="{{ all_fields|json_encode }}"
         data-adminata-choice-field-mask-map="{{ map|json_encode }}">
        {{ block('choice_widget') }}
    </div>
{% endblock %}

{#
    `sortable` was a select2 plugin that kept the order of a multiple choice in a hidden comma
    separated input. Without select2 there is no ordering UI, so the field is the plain multiple
    select it always was underneath (PLAN/01 J6); the application has none.
#}
{% block adminata_type_choice_multiple_sortable %}
    {{ block('choice_widget_collapsed') }}
{% endblock %}

{#
    Not ported: the widget is inherited markup and lives in its own file, which is what keeps this
    theme free of Bootstrap and of inline scripts (PLAN/03 §E).
#}
{% block adminata_type_model_list_widget %}
    {% include '@Adminata/Form/Type/adminata_type_model_list.html.twig' %}
{% endblock %}

{% block adminata_type_template_widget %}
    {% include template with parameters only %}
{% endblock adminata_type_template_widget %}
