{#
    Native date, time and datetime-local inputs (PLAN/06 §4).

    Tempus Dominus is gone with jQuery and nothing replaced it: `BasePickerType` derives the wire
    format from `datepicker_options.display.components`, and this template turns the same three
    booleans into the input type the browser then owns. `seconds` becomes `step="1"`, and
    `restrictions.minDate`/`maxDate` become `min`/`max` in the shape the type expects.

    `datepicker_use_button` and `wrap_fields_with_addons` render nothing: the button opened a
    JavaScript calendar and the addon was Bootstrap's `input-group`.
#}

{% block adminata_type_datetime_picker_widget %}
    {{- block('adminata_type_datetime_picker_widget_html') -}}
{% endblock adminata_type_datetime_picker_widget %}

{% block adminata_type_datetime_picker_widget_html %}
    {#- `??` and not `|default()`: the default filter also replaces a value that is *empty*, and
        `false` is empty — which is the one value each of these three carries. -#}
    {%- set components = datepicker_options.display.components ?? {} -%}
    {%- set with_calendar = (components.calendar ?? true) is not same as(false) -%}
    {%- set with_clock = (components.clock ?? true) is not same as(false) -%}
    {%- set with_seconds = (components.seconds ?? false) is same as(true) -%}

    {%- set type = with_clock ? (with_calendar ? 'datetime-local' : 'time') : 'date' -%}
    {%- set pattern = 'date' == type
        ? 'Y-m-d'
        : ('time' == type
            ? (with_seconds ? 'H:i:s' : 'H:i')
            : (with_seconds ? 'Y-m-d\\TH:i:s' : 'Y-m-d\\TH:i')) -%}

    {%- if with_seconds and 'date' != type -%}
        {%- set attr = attr|merge({step: '1'}) -%}
    {%- endif -%}

    {%- set restrictions = datepicker_options.restrictions|default({}) -%}
    {%- if restrictions.minDate is defined -%}
        {%- set attr = attr|merge({min: restrictions.minDate|date(pattern)}) -%}
    {%- endif -%}
    {%- if restrictions.maxDate is defined -%}
        {%- set attr = attr|merge({max: restrictions.maxDate|date(pattern)}) -%}
    {%- endif -%}

    {#- The admin theme's `form_widget_simple` adds `adm-input`; a plain form outside it does not,
        and a native picker still has to look like the rest of the page. The recipe is idempotent. -#}
    {%- set attr = attr|merge({class: [
        attr.class|default(''),
        'adm-input' in attr.class|default('') ? '' : 'adm-input',
    ]|filter(part => part is not empty)|join(' ')}) -%}

    {{- block('form_widget_simple') -}}
{% endblock adminata_type_datetime_picker_widget_html %}
