{#
    The show page (PLAN/03 §D).

    `adminata-view`, `adminata-view-container` and the `<table><tr><th><td>` a field renders into
    are the contract — the show tests assert that shape — so the table is styled rather than
    replaced. Groups become cards in the same twelve-column grid (or `masonry` columns) the edit
    page uses, and a tabbed show page takes the edit form's tabs, `adminata-tabs` included.
#}

{% extends base_template %}

{% block title %}
    {{ 'title_show'|trans({'%name%': admin.toString(object)|u.truncate(15, '...') }, 'AdminataBundle') }}
{% endblock %}

{% block navbar_title %}
    {{ 'title_show'|trans({'%name%': admin.toString(object)|u.truncate(100, '...') }, 'AdminataBundle') }}
{% endblock %}

{%- block actions -%}
    {% include '@Adminata/CRUD/action_buttons.html.twig' %}
{%- endblock -%}

{% block tab_menu %}
    {{ knp_menu_render(admin.sidemenu(action), {
        'currentClass' : 'active',
        'template': get_global_template('tab_menu_template')
    }, 'twig') }}
{% endblock %}

{% block show %}
    <div class="adminata-view">

        {{ adminata_block_render_event('adminata.admin.show.top', { 'admin': admin, 'object': object }) }}

        {% set showtabs = admin.getshowtabs() %}
        {% set has_tab = (showtabs|length == 1 and showtabs|keys[0] != 'default') or showtabs|length > 1 %}

        {% if has_tab %}
            {#- The same tabs as the edit form's, without `adminata-edit`: nothing is submitted, so
                nothing remembers the tab, but a `?_tab=` in the address still selects by index. -#}
            {% set tab_prefix = 'tab_' ~ admin.uniqid %}
            {% set tab_query_index = app.request.query.get('_tab', '')|split('_')|last %}
            <div class="adm-tabs" {{ stimulus_controller('adminata-tabs') }}>
                <div class="adm-tablist" role="tablist">
                    {% for code, show_tab in showtabs %}
                        {% set _tab_name = tab_prefix ~ '_' ~ loop.index %}
                        {% set _tab_selected = ('' == tab_query_index and loop.first) or tab_query_index == loop.index %}
                        <a href="#{{ _tab_name }}"
                                class="adm-tab"
                                role="tab"
                                id="{{ _tab_name }}-tab"
                                aria-controls="{{ _tab_name }}"
                                aria-selected="{{ _tab_selected ? 'true' : 'false' }}"
                                tabindex="{{ _tab_selected ? '0' : '-1' }}"
                                {{ stimulus_target('adminata-tabs', 'tab') }}
                                {{
                                    stimulus_action('adminata-tabs', 'select')|
                                    stimulus_action('adminata-tabs', 'move', 'keydown')
                                }}>
                            {%- if show_tab.translation_domain is defined and show_tab.translation_domain is same as(false) -%}
                                {{ show_tab.label }}
                            {%- else -%}
                                {{ show_tab.label|trans({}, show_tab.translation_domain ?? admin.translationDomain) }}
                            {%- endif -%}
                        </a>
                    {% endfor %}
                </div>
                {% for code, show_tab in showtabs %}
                    {% set _tab_name = tab_prefix ~ '_' ~ loop.index %}
                    {% set _tab_selected = ('' == tab_query_index and loop.first) or tab_query_index == loop.index %}
                    <section id="{{ _tab_name }}"
                             role="tabpanel"
                             aria-labelledby="{{ _tab_name }}-tab"
                             {{ stimulus_target('adminata-tabs', 'panel') }}
                             {% if not _tab_selected %}hidden{% endif %}>
                        {% if show_tab.description != false %}
                            <p class="adm-card-subtitle mb-4">{{ show_tab.description|raw }}</p>
                        {% endif %}

                        {% set groups = show_tab.groups %}
                        {{ block('show_groups') }}
                    </section>
                {% endfor %}
            </div>
        {% elseif showtabs['default'] is defined %}
            {% set show_tab = showtabs['default'] %}
            {% set groups = show_tab.groups %}
            {{ block('show_groups') }}
        {% endif %}

    </div>

    {{ adminata_block_render_event('adminata.admin.show.bottom', { 'admin': admin, 'object': object }) }}
{% endblock %}

{% block show_groups %}
    {#- The page title is the `<h1>` and a group heading the `<h2>`; a tab is a button, not a heading. -#}
    {% set heading = 'h2' %}
    {#- A tab whose `layout` is `masonry` packs its groups as the edit form's macro does
        (`base_edit_form_macro.html.twig` says why); the twelve-column grid is the default. -#}
    {% set masonry = 'masonry' == (show_tab.layout|default('grid')) %}
    {% if masonry %}
    <div class="grid {{ show_tab.columns|default('grid-cols-1 lg:grid-cols-2 xl:grid-cols-3') }} gap-6 items-start" {{ stimulus_controller('adminata-masonry') }}>
    {% else %}
    <div class="grid grid-cols-12 gap-6">
    {% endif %}
        {% block field_row %}
            {% for code in groups %}
                {% set show_group = admin.showgroups[code] %}

                {#- `min-w-0` for the same reason as the list's card: a grid item will not shrink
                    below its content, and the content is a table. -#}
                {% if masonry %}
                <div class="min-w-0{% if show_group.class %} {{ show_group.class }}{% endif %}" {{ stimulus_target('adminata-masonry', 'item') }}>
                {% else %}
                <div class="{{ show_group.class|default('col-span-12') }} min-w-0">
                {% endif %}
                    <div class="adm-card {{ show_group.box_class }}">
                        <div class="adm-card-header">
                            <{{ heading }} class="adm-card-title">
                                {% block show_title %}
                                    {% if show_group.translation_domain is defined and show_group.translation_domain is same as(false) %}
                                        {{ show_group.label }}
                                    {% else %}
                                        {{ show_group.label|trans({}, show_group.translation_domain ?? admin.translationDomain) }}
                                    {% endif %}
                                {% endblock %}
                            </{{ heading }}>
                        </div>
                        <div class="adm-card-body p-0">
                            <div class="adm-table-wrap">
                                <div class="adm-table-scroll">
                                <table class="adm-show-table">
                                    <tbody>
                                    {% for show_field_name in show_group.fields %}
                                        {% block show_field %}
                                            <tr class="adminata-view-container">
                                                {% if elements[show_field_name] is defined %}
                                                    {{ elements[show_field_name]|render_view_element(object) }}
                                                {% endif %}
                                            </tr>
                                        {% endblock %}
                                    {% endfor %}
                                    </tbody>
                                </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endblock %}
    </div>
{% endblock %}
