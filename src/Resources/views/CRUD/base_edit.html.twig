{% extends base_template %}

{#
    A create page is headed by the title its admin gives the `create` screen (the `titles`
    attribute of the `adminata.admin` tag), in the admin's domain — the words its last crumb
    says — and by the generic "Create" when it gives none. Only the object's name is shortened.
#}
{% block title %}
    {% if objectId is not null %}
        {{ 'title_edit'|trans({'%name%': admin.toString(object)|u.truncate(15, '...') }, 'AdminataBundle') }}
    {% elseif admin.title('create') is not empty %}
        {{ admin.title('create')|trans({}, admin.translationDomain) }}
    {% else %}
        {{ 'title_create'|trans({}, 'AdminataBundle')|u.truncate(15, '...') }}
    {% endif %}
{% endblock %}

{% block navbar_title %}
    {% if objectId is not null %}
        {{ 'title_edit'|trans({'%name%': admin.toString(object)|u.truncate(100, '...') }, 'AdminataBundle') }}
    {% elseif admin.title('create') is not empty %}
        {{ admin.title('create')|trans({}, admin.translationDomain) }}
    {% else %}
        {{ 'title_create'|trans({}, 'AdminataBundle')|u.truncate(100, '...') }}
    {% endif %}
{% endblock %}

{%- block actions -%}
    {% include '@Adminata/CRUD/action_buttons.html.twig' %}
{%- endblock -%}

{%- block tab_menu -%}
    {{ knp_menu_render(admin.sidemenu(action), {
        'currentClass': 'active',
        'template': get_global_template('tab_menu_template')
    }, 'twig') }}
{%- endblock -%}

{% use '@Adminata/CRUD/base_edit_form.html.twig' with form as parentForm %}

{% block form %}
    {{ block('parentForm') }}
{% endblock %}
