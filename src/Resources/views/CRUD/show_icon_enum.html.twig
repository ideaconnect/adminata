{#
    An enum as an icon on a show page: the square and, beside it, the label — a value next to
    its own row header has no legend to lean on.
#}

{% extends '@Adminata/CRUD/base_show_field.html.twig' %}

{% block field %}
    {%- set icon_enum_case = adminata_icon_enum(value, field_description) -%}
    {%- if icon_enum_case is not null -%}
        {%- include '@Adminata/CRUD/display_icon_enum.html.twig' with { case: icon_enum_case, with_label: true } only -%}
    {%- endif -%}
{% endblock %}
