{% if not adminata_admin.field_description.hasassociationadmin %}
    {{ value|render_relation_element(adminata_admin.field_description) }}
{% elseif adminata_admin.edit == 'inline' %}
    {% for field_description in adminata_admin.field_description.associationadmin.formfielddescriptions %}
        {{ form_row(form[field_description.name]) }}
    {% endfor %}
{% else %}
    <div id="field_container_{{ id }}" class="field-container">
        {% if adminata_admin.edit == 'list' %}
            <span id="field_widget_{{ id }}" class="field-short-description">
                {% if adminata_admin.value and adminata_admin.field_description.associationadmin.id(adminata_admin.value) is not null %}
                    {{ render(path('adminata_short_object_information', {
                        '_adminata_admin': adminata_admin.field_description.associationadmin.baseCodeRoute,
                        'objectId': adminata_admin.field_description.associationadmin.id(adminata_admin.value),
                        'uniqid': adminata_admin.field_description.associationadmin.uniqid,
                        'linkParameters': adminata_admin.field_description.option('link_parameters', {})
                    } + (
                        adminata_admin.field_description.associationadmin.hasRequest()
                        ? adminata_admin.field_description.associationadmin.request.attributes.get('_route_params', {})
                        : {}
                    ) + app.request.query.all|default({})
                    )) }}
                {% elseif adminata_admin.field_description.option('placeholder', 'short_object_description_placeholder') %}
                    <span class="inner-field-short-description">
                        {{ adminata_admin.field_description.option('placeholder', 'short_object_description_placeholder')|trans({}, 'AdminataBundle') }}
                    </span>
                {% endif %}
            </span>
            <span style="display: none" >
                {{ form_widget(form) }}
            </span>
        {% else %}
            <span id="field_widget_{{ id }}" >
                {{ form_widget(form) }}
            </span>
        {% endif %}

        <div id="field_actions_{{ id }}" class="field-actions">
            {% set display_btn_list = adminata_admin.edit == 'list'
                and adminata_admin.field_description.associationadmin.hasRoute('list')
                and adminata_admin.field_description.associationadmin.hasAccess('list')
                and btn_list %}
            {% set display_btn_add = adminata_admin.edit != 'admin'
                and adminata_admin.field_description.associationadmin.hasRoute('create')
                and adminata_admin.field_description.associationadmin.hasAccess('create')
                and btn_add %}
            {% if display_btn_list or display_btn_add %}
            <div class="btn-group">
                {% if display_btn_list %}
                    <a  href="{{ adminata_admin.field_description.associationadmin.generateUrl('list', {select: true}|merge(adminata_admin.field_description.getOption('link_parameters', {}))) }}"
                        onclick="return start_field_dialog_form_list_{{ id }}(this);"
                        class="btn btn-info btn-sm adminata-action"
                        {# NEXT_MAJOR: Remove the fallback on null and on btn_catalogue #}
                        title="{{
                            btn_translation_domain|default(null) is same as(false)
                            ? btn_list
                            : btn_list|trans({}, btn_translation_domain|default(btn_catalogue))
                        }}"
                        >
                        <i class="fas fa-list"></i>
                        {# NEXT_MAJOR: Remove the fallback on null and on btn_catalogue #}
                        {{
                            btn_translation_domain|default(null) is same as(false)
                            ? btn_list
                            : btn_list|trans({}, btn_translation_domain|default(btn_catalogue))
                        }}
                    </a>
                {% endif %}

                {% if display_btn_add %}
                    <a  href="{{ adminata_admin.field_description.associationadmin.generateUrl('create', adminata_admin.field_description.getOption('link_parameters', {})) }}"
                        onclick="return start_field_dialog_form_add_{{ id }}(this);"
                        class="btn btn-success btn-sm adminata-action"
                        {# NEXT_MAJOR: Remove the fallback on null and on btn_catalogue #}
                        title="{{
                            btn_translation_domain|default(null) is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain|default(btn_catalogue))
                        }}"
                        >
                        <i class="fas fa-plus-circle"></i>
                        {# NEXT_MAJOR: Remove the fallback on null and on btn_catalogue #}
                        {{
                            btn_translation_domain|default(null) is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain|default(btn_catalogue))
                        }}
                    </a>
                {% endif %}
            </div>
            {% endif %}

            {% set display_btn_delete = adminata_admin.edit == 'list'
                and adminata_admin.field_description.associationadmin.hasRoute('delete')
                and adminata_admin.field_description.associationadmin.hasAccess('delete')
                and btn_delete %}
            {% if display_btn_delete %}
                <a  href=""
                    onclick="return remove_selected_element_{{ id }}(this);"
                    class="btn btn-danger btn-sm adminata-action"
                    {# NEXT_MAJOR: Remove the fallback on null and on btn_catalogue #}
                    title="{{
                        btn_translation_domain|default(null) is same as(false)
                        ? btn_delete
                        : btn_delete|trans({}, btn_translation_domain|default(btn_catalogue))
                    }}"
                    >
                    <i class="fas fa-minus-circle"></i>
                    {# NEXT_MAJOR: Remove the fallback on null and on btn_catalogue #}
                    {{
                        btn_translation_domain|default(null) is same as(false)
                        ? btn_delete
                        : btn_delete|trans({}, btn_translation_domain|default(btn_catalogue))
                    }}
                </a>
            {% endif %}

            {% if display_btn_list or display_btn_add or display_btn_delete %}
                {% include '@Adminata/CRUD/Association/edit_modal.html.twig' %}
                {% include '@Adminata/CRUD/Association/edit_many_script.html.twig' %}
            {% endif %}
        </div>
    </div>
{% endif %}
