{%- apply trim|raw %}
    {% if value %}
        {% set text = 'label_type_yes'|trans({}, 'AdminataBundle') %}
    {% else %}
        {% set text = 'label_type_no'|trans({}, 'AdminataBundle') %}
    {% endif %}

    {# `label label-*` was Bootstrap's and is in PLAN/02 §8's dropped list. #}
    {% if inverse|default(false) ? not value : value %}
        {% set class = 'adm-badge-success' %}
    {% else %}
        {% set class = 'adm-badge-error' %}
    {% endif %}

    <span class="adm-badge {{ class }}">{{ text }}</span>
{% endapply -%}
