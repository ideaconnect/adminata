{#
    The edit form (PLAN/03 §C).

    All sixteen blocks keep their names — an application overrides `form`, `adminata_pre_fieldsets`,
    `adminata_post_fieldsets` and `adminata_form_actions` — and so do the `btn_*` submit names, the
    `_tab` parameter, `adminata-form-actions`, `adminata-collapsed-fields` and `form_rest`, which
    is what carries `_lock_version`.

    A tabbed form is the WAI-ARIA tabs pattern — `adm-tablist` of `adm-tab` links over
    `role="tabpanel"` sections — driven by `adminata-tabs`, with `adminata-edit` on the same
    links: it writes the selected tab into `?_tab=` and the `_tab` field, and sends
    `adminata-tabs:show` to the first tab holding a field with an error. The selected tab comes
    back by its INDEX (`tab_query_index`): the tab ids carry the admin's uniqid, which the
    redirect after a save does not, so `?_tab=tab_<other uniqid>_2` must still mean the second.
    The tabs are `<a>`, not `<button>`, on purpose: an application locks a read-only form by
    wrapping `adminata_tab_content` in a disabled `<fieldset>`, which disables every button
    inside it — the tabs included, and with them every panel but the first. A link stays a link.
#}

{% block form %}
    {{ adminata_block_render_event('adminata.admin.edit.form.top', { 'admin': admin, 'object': object }) }}

    {% set url = objectId is not null ? 'edit' : 'create' %}

    {% if not admin.hasRoute(url) %}
        <div class="adm-callout adm-callout-warning">
            {{ "form_not_available"|trans({}, "AdminataBundle") }}
        </div>
    {% else %}
        <form
              action="{% block adminata_form_action_url %}{{ admin.generateUrl(url, {(admin.idParameter): objectId, 'uniqid': admin.uniqid, 'subclass': app.request.attributes.get('subclass', app.request.query.get('subclass', app.request.request.get('subclass')))}) }}{% endblock %}"
              {% if form.vars.multipart %} enctype="multipart/form-data"{% endif %}
              method="POST"
              {% if not adminata_config.getOption('html5_validate') %}novalidate="novalidate"{% endif %}
              {{
                stimulus_controller('adminata-confirm-exit')|
                stimulus_controller('adminata-edit')
              }}
              {{
                stimulus_action('adminata-confirm-exit', 'confirm', 'beforeunload@window')|
                stimulus_action('adminata-confirm-exit', 'skip', 'submit')|
                stimulus_action('adminata-edit', 'prepareSubmit', 'submit')|
                stimulus_action('adminata-edit', 'checkValidity:capture', 'invalid')
              }}
              {% block adminata_form_attributes %}{% endblock %}
              >

            {{ include('@Adminata/Helper/render_form_dismissable_errors.html.twig') }}

            {% block adminata_pre_fieldsets %}
                <div>
            {% endblock %}

            {% block adminata_tab_content %}
                {% import "@Adminata/CRUD/base_edit_form_macro.html.twig" as form_helper %}
                {% set formtabs = admin.getformtabs() %}
                {% set has_tab = ((formtabs|length == 1 and formtabs|keys[0] != 'default') or formtabs|length > 1 ) %}

                {% if has_tab %}
                    {% set tab_prefix = 'tab_' ~ admin.uniqid %}
                    {% set tab_query_index = app.request.query.get('_tab', '')|split('_')|last %}
                    <div class="adm-tabs" {{ stimulus_controller('adminata-tabs') }}>
                        <div class="adm-tablist" role="tablist">
                            {% for code, form_tab in formtabs %}
                                {% set _tab_name = tab_prefix ~ '_' ~ loop.index %}
                                {% set _tab_selected = ('' == tab_query_index and loop.first) or tab_query_index == loop.index %}
                                <a href="#{{ _tab_name }}"
                                        class="adm-tab"
                                        role="tab"
                                        id="{{ _tab_name }}-tab"
                                        aria-controls="{{ _tab_name }}"
                                        aria-selected="{{ _tab_selected ? 'true' : 'false' }}"
                                        tabindex="{{ _tab_selected ? '0' : '-1' }}"
                                        {{ stimulus_target('adminata-tabs', 'tab') }}
                                        {{ stimulus_target('adminata-edit', 'tab') }}
                                        {{
                                            stimulus_action('adminata-tabs', 'select')|
                                            stimulus_action('adminata-tabs', 'move', 'keydown')|
                                            stimulus_action('adminata-edit', 'changeTab')
                                        }}>
                                    <i class="fas fa-circle-exclamation adm-tab-errors" aria-hidden="true" hidden {{ stimulus_target('adminata-edit', 'errorMark') }}></i>
                                    {%- if form_tab.translation_domain is defined and form_tab.translation_domain is same as(false) -%}
                                        {{ form_tab.label }}
                                    {%- else -%}
                                        {{ form_tab.label|trans({}, form_tab.translation_domain ?? admin.translationDomain) }}
                                    {%- endif -%}
                                </a>
                            {% endfor %}
                        </div>
                        {% for code, form_tab in formtabs %}
                            {% set _tab_name = tab_prefix ~ '_' ~ loop.index %}
                            {% set _tab_selected = ('' == tab_query_index and loop.first) or tab_query_index == loop.index %}
                            <section id="{{ _tab_name }}"
                                     class="adminata-collapsed-fields"
                                     role="tabpanel"
                                     aria-labelledby="{{ _tab_name }}-tab"
                                     {{ stimulus_target('adminata-tabs', 'panel') }}
                                     {% if not _tab_selected %}hidden{% endif %}>
                                {% if form_tab.description != false %}
                                    <p class="adm-card-subtitle mb-4">
                                        {%- if form_tab.translation_domain is defined and form_tab.translation_domain is same as(false) -%}
                                            {{ form_tab.description|raw }}
                                        {%- else -%}
                                            {{ form_tab.description|trans({}, form_tab.translation_domain ?? admin.translationDomain)|raw }}
                                        {%- endif -%}
                                    </p>
                                {% endif %}

                                {{ form_helper.render_groups(admin, form, form_tab['groups'], has_tab, form_tab) }}
                            </section>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="_tab" value="{{ app.request.query.get('_tab') }}" {{ stimulus_target('adminata-edit', 'tabStore') }}>
                {% elseif formtabs['default'] is defined %}
                    {{ form_helper.render_groups(admin, form, formtabs['default'].groups, has_tab, formtabs['default']) }}
                {% endif %}
            {% endblock %}

            {% block adminata_post_fieldsets %}
                </div>
            {% endblock %}

            {{ form_rest(form) }}

            {% block formactions %}
                <div class="adminata-form-actions adm-sticky mt-6 flex flex-wrap items-center gap-3 px-4 py-3"
                     {{ stimulus_target('adminata-sticky', 'action') }}>
                {% block adminata_form_actions %}
                    {% if app.request.isxmlhttprequest %}
                        {% if objectId is not null %}
                            <button type="submit" class="adm-btn adm-btn-primary" name="btn_update"><i class="fas fa-floppy-disk" aria-hidden="true"></i> {{ 'btn_update'|trans({}, 'AdminataBundle') }}</button>
                            {% if admin.hasRoute('delete') and admin.hasAccess('delete', object) %}
                                {% block btn_delete %}
                                    <span class="adm-help">{{ 'delete_or'|trans({}, 'AdminataBundle') }}</span>
                                    <a class="adm-btn adm-btn-danger" href="{{ admin.generateObjectUrl('delete', object) }}">
                                        <i class="fas fa-circle-minus" aria-hidden="true"></i> {{ 'link_delete'|trans({}, 'AdminataBundle') }}
                                    </a>
                                {% endblock %}
                            {% endif %}
                        {% else %}
                            {% block btn_create %}
                                <button type="submit" class="adm-btn adm-btn-primary" name="btn_create"><i class="fas fa-circle-plus" aria-hidden="true"></i> {{ 'btn_create'|trans({}, 'AdminataBundle') }}</button>
                            {% endblock %}
                        {% endif %}
                    {% else %}
                        {% if admin.supportsPreviewMode %}
                            {% block btn_preview %}
                                <button class="adm-btn adm-btn-secondary persist-preview" name="btn_preview" type="submit">
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                    {{ 'btn_preview'|trans({}, 'AdminataBundle') }}
                                </button>
                            {% endblock %}
                        {% endif %}
                        {% if objectId is not null %}
                            {% block btn_update_and_edit %}
                                <button type="submit" class="adm-btn adm-btn-primary" name="btn_update_and_edit"><i class="fas fa-floppy-disk" aria-hidden="true"></i> {{ 'btn_update_and_edit_again'|trans({}, 'AdminataBundle') }}</button>
                            {% endblock %}

                            {% if admin.hasRoute('list') and admin.hasAccess('list') %}
                                {% block btn_update_and_list %}
                                    <button type="submit" class="adm-btn adm-btn-secondary" name="btn_update_and_list"><i class="fas fa-list" aria-hidden="true"></i> {{ 'btn_update_and_return_to_list'|trans({}, 'AdminataBundle') }}</button>
                                {% endblock %}
                            {% endif %}

                            {% if admin.hasRoute('delete') and admin.hasAccess('delete', object) %}
                                {{ block('btn_delete') }}
                            {% endif %}

                            {% if admin.isAclEnabled() and admin.hasRoute('acl') and admin.hasAccess('acl', object) %}
                                {% block btn_acl %}
                                    <a class="adm-btn adm-btn-secondary" href="{{ admin.generateObjectUrl('acl', object) }}"><i class="fas fa-users" aria-hidden="true"></i> {{ 'link_edit_acl'|trans({}, 'AdminataBundle') }}</a>
                                {% endblock %}
                            {% endif %}
                        {% else %}
                            {% if admin.hasroute('edit') and admin.hasAccess('edit') %}
                                {% block btn_create_and_edit %}
                                    <button class="adm-btn adm-btn-primary" type="submit" name="btn_create_and_edit"><i class="fas fa-floppy-disk" aria-hidden="true"></i> {{ 'btn_create_and_edit_again'|trans({}, 'AdminataBundle') }}</button>
                                {% endblock %}
                            {% endif %}
                            {% if admin.hasroute('list') and admin.hasAccess('list') %}
                                {% block btn_create_and_list %}
                                    <button type="submit" class="adm-btn adm-btn-secondary" name="btn_create_and_list"><i class="fas fa-list" aria-hidden="true"></i> {{ 'btn_create_and_return_to_list'|trans({}, 'AdminataBundle') }}</button>
                                {% endblock %}
                            {% endif %}
                            {% block btn_create_and_create %}
                                <button class="adm-btn adm-btn-secondary" type="submit" name="btn_create_and_create"><i class="fas fa-circle-plus" aria-hidden="true"></i> {{ 'btn_create_and_create_a_new_one'|trans({}, 'AdminataBundle') }}</button>
                            {% endblock %}
                        {% endif %}
                    {% endif %}
                {% endblock %}
                </div>
            {% endblock formactions %}
        </form>
    {% endif %}

    {{ adminata_block_render_event('adminata.admin.edit.form.bottom', { 'admin': admin, 'object': object }) }}

{% endblock %}
