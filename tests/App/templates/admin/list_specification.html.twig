{#
    The other shape: a cell template that emits its own `<td>` rather than extending the envelope.
    Some of the application's templates do this, so the list body must not assume the bundle wrote
    the cell (PLAN/01 Q1).
#}
<td class="sonata-ba-list-field sonata-ba-list-field-{{ field_description.type }} demo-specification" objectId="{{ admin.id(object) }}">
    <dl class="grid grid-cols-2 gap-x-2 text-theme-xs">
        {% for key, item in value %}
            <dt class="text-gray-500 dark:text-gray-400">{{ key }}</dt>
            <dd>{{ item }}</dd>
        {% endfor %}
    </dl>
</td>
