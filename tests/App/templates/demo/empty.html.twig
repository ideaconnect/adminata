    This is the shape a login or a password page takes.
#}

{% extends '@SonataAdmin/empty_layout.html.twig' %}

{% block content %}
    <div class="adm-card m-6 max-w-md">
        <div class="adm-card-header">
            <h1 class="adm-card-title">Empty layout</h1>
        </div>
        <div class="adm-card-body">
