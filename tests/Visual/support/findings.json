{
    "axe": {
        "dashboard:light": [
            "aria-required-parent",
            "list"
        ],
        "dashboard:dark": [
            "aria-required-parent",
            "list"
        ],
        "product-list:light": [
            "aria-required-children",
            "aria-required-parent",
            "label",
            "link-name",
            "list",
            "listitem",
            "select-name"
        ],
        "product-list:dark": [
            "aria-required-children",
            "aria-required-parent",
            "label",
            "link-name",
            "list",
            "listitem",
            "select-name"
        ],
        "product-create:light": [
            "aria-required-parent",
            "button-name",
            "link-name",
            "list"
        ],
        "product-create:dark": [
            "aria-required-parent",
            "button-name",
            "link-name",
            "list"
        ]
    },
    "markup": {
        "dashboard": [
            "heading-level",
            "long-title",
            "no-deprecated-attr",
            "valid-id"
        ],
        "product-list": [
            "input-missing-label",
            "long-title",
            "no-inline-style",
            "no-redundant-for",
            "no-redundant-role",
            "prefer-button",
            "valid-for",
            "wcag/h30"
        ],
        "product-create": [
            "heading-level",
            "long-title",
            "no-inline-style",
            "no-redundant-role",
            "text-content",
            "wcag/h30"
        ]
    },
    "responsive": {
        "product-list@chromium-narrow": [
            "horizontal-overflow"
        ],
        "product-list@firefox-narrow": [
            "horizontal-overflow"
        ],
        "product-list@webkit-narrow": [
            "horizontal-overflow"
        ]
    }
}
