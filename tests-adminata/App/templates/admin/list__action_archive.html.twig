{#
    A custom row action, the way the application adds its eleven (appendix C §2): the same recipes
    as the bundle's own, reached through `_action`'s `actions` option.
#}
{% if admin.hasAccess('edit', object) and admin.hasRoute('archive') %}
    {% set button_content = adminata_config.getOption('list_action_button_content') %}
    {% set show_icon = button_content in ['icon', 'all'] %}
    {% set show_text = button_content in ['text', 'all'] %}
    {% set recipe = show_text ? 'adm-btn adm-btn-secondary adm-btn-sm' : 'adm-btn-icon' %}
    <a
        href="{{ admin.generateObjectUrl('archive', object) }}"
        class="{{ recipe }} archive_link"
        title="Archive"
    >
        {% if show_icon %}
            <i class="fas fa-box-archive" aria-hidden="true"></i>
        {% endif %}
        {% if show_text %}
            Archive
        {% else %}
            <span class="sr-only">Archive</span>
        {% endif %}
    </a>
{% endif %}
