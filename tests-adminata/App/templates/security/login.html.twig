{#
    The demo's login page: an application's own template on the admin layout with `logo`,
    `adminata_nav` and `adminata_left_side` emptied, which is how recomaty-panel writes its login and
    password pages (appendix C §2). `adminata_header` then renders nothing at all — that is PLAN/01
    T9, and this page is what proves it.
#}

{% extends '@Adminata/standard_layout.html.twig' %}

{% block logo %}{% endblock %}
{% block adminata_nav %}{% endblock %}
{% block adminata_left_side %}{% endblock %}

{% block adminata_head_title %}{{ 'Admin'|trans({}, 'AdminataBundle') }} — sign in{% endblock %}

{% block content %}
    {#- A `style` and not `mx-auto max-w-sm`: the demo runs on adminata's shipped stylesheet
        alone, and those utilities are not in it — adminata generates what its own templates
        use, and an application that wants more compiles Tailwind itself (PLAN/04 §7). -#}
    <div style="max-width: 24rem; margin-inline: auto;">
        <form method="post" action="{{ path('demo_login') }}" class="adm-card">
            <div class="adm-card-body flex flex-col gap-3">
                <h1 class="adm-card-title">{{ adminata_config.title }}</h1>

                {% if error %}
                    <p class="adm-alert adm-alert-error" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </p>
                {% endif %}

                <div>
                    <label class="adm-label" for="username">Username</label>
                    <input class="adm-input" type="text" id="username" name="_username"
                           value="{{ last_username }}" autocomplete="username" required autofocus>
                </div>

                <div>
                    <label class="adm-label" for="password">Password</label>
                    <input class="adm-input" type="password" id="password" name="_password"
                           autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="adm-btn adm-btn-primary" type="submit">Sign in</button>
            </div>
        </form>
    </div>
{% endblock %}
