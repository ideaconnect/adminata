{#
    A page of the demo application on the admin layout, opening a native `<dialog>` through
    `sonata-modal`. Nothing here is adminata's own markup: it is what an application writes.
#}

{% extends '@SonataAdmin/standard_layout.html.twig' %}

{% block navbar_title %}Dialog{% endblock %}

{% block content %}
    <div class="adm-card"
         {{ stimulus_controller('sonata-modal', {size: 'md', closable: true}) }}
    >
        <div class="adm-card-body">
            <button type="button" class="adm-btn adm-btn-primary" id="open-dialog"
                    {{ stimulus_action('sonata-modal', 'open', 'click') }}
            >
                Open the dialog
            </button>
        </div>

        <dialog id="demo-dialog" aria-labelledby="demo-dialog-title" {{ stimulus_target('sonata-modal', 'dialog') }}>
            <div class="adm-dialog__header">
                <h2 class="adm-card-title" id="demo-dialog-title">A dialog</h2>
                <button type="button" class="adm-btn-icon adm-btn-icon-round" id="close-dialog"
                        aria-label="Close"
                        {{ stimulus_action('sonata-modal', 'close', 'click') }}
                >
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="adm-dialog__body">
                <p>The browser's top layer gives the focus trap and the Escape key; the controller
                   decides the size, whether the backdrop closes it, and announces both.</p>
            </div>
            <div class="adm-dialog__footer">
                <button type="button" class="adm-btn adm-btn-secondary" id="dismiss-dialog"
                        {{ stimulus_action('sonata-modal', 'close', 'click') }}
                >
                    Close
                </button>
            </div>
        </dialog>
    </div>

    {# The layout's shared dialog, opened from anywhere: what an application's list cell or show
       page writes when it has a note to show and no dialog of its own. #}
    <div class="adm-card mt-6">
        <div class="adm-card-body flex flex-wrap gap-3">
            <template id="demo-note">
                <p><strong>Formatted</strong> content, copied from a <code>&lt;template&gt;</code> on the page.</p>
            </template>
            <button type="button" class="adm-btn adm-btn-secondary" id="open-shared-text" aria-haspopup="dialog"
                    {{ stimulus_controller('sonata-modal-trigger', {
                        title: 'A note',
                        text: 'Plain text, exactly as written: <b>not markup</b>.',
                    }) }}
                    {{ stimulus_action('sonata-modal-trigger', 'open', 'click') }}
            >
                Open the shared dialog with text
            </button>
            <button type="button" class="adm-btn adm-btn-secondary" id="open-shared-content" aria-haspopup="dialog"
                    {{ stimulus_controller('sonata-modal-trigger', {title: 'A formatted note', content: 'demo-note', size: 'lg'}) }}
                    {{ stimulus_action('sonata-modal-trigger', 'open', 'click') }}
            >
                Open it with formatted content
            </button>
        </div>
    </div>

    {# The layout's question dialog: what an application's row action or form writes in place of
       a `window.confirm()`. The form goes out only once the question is answered with yes. #}
    <div class="adm-card mt-6">
        <form class="adm-card-body" method="get" action="{{ path('demo_dialog') }}">
            <input type="hidden" name="asked" value="1">
            <button type="submit" class="adm-btn adm-btn-secondary" id="ask-question" aria-haspopup="dialog"
                    {{ stimulus_controller('sonata-question', {
                        title: 'Reload the page?',
                        text: 'The flashes will show again. Nothing else happens.',
                        confirm: 'Reload',
                    }) }}
                    {{ stimulus_action('sonata-question', 'ask', 'click') }}
            >
                Ask before submitting
            </button>
        </form>
    </div>
{% endblock %}
